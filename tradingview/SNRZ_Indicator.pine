//@version=6
// build: v2.1  — PO2 only on inversion-zone 2nd touch; book naming I.VS / I.VR
// ═══════════════════════════════════════════════════════════════════════════
//  SNRZ Strategy Indicator  —  "Zindan The Gold Chaser" Masterclass
//
//  Strict rules implemented (docs/SNRZ_STRATEGY.md):
//   • A zone is tradable ONLY when it is:
//       - VALID  (First Big Movement + Second Big Movement), or
//       - INVERSION (broken zone → RBS / SBR / I.VR / I.VS, retest entry)
//     Fresh one-movement zones are shown faint and give NO signals.
//   • Power of Second Touch (PO2): per the book, PO2 exists ONLY on
//     inversion zones — the 2nd retest of a broken zone is the strongest
//     entry. Valid-zone retests (touch 2-3) are regular V.S / V.R entries.
//   • One signal per touch (never repeats while price sits inside a zone).
//   • 75% breakout rule (body + directional shadow only) decides real breaks.
//   • Confirmation candle required: SNRZ engulfing (body close beyond previous
//     body) or pin-bar rejection.
//   • Trend filter (structure HH/HL vs LH/LL): with-trend only, except
//     inversion retests which are allowed counter-trend per the course.
//  Best market per the course: XAUUSD.  Zones: H1/H4 — Entry: M15/M5.
// ═══════════════════════════════════════════════════════════════════════════
indicator("SNRZ Strategy [Zindan]", "SNRZ", overlay = true, max_boxes_count = 250, max_labels_count = 250)

// ───────────────────────────── Inputs ──────────────────────────────────────
grpZ  = "Zones (SNRZ)"
pivotLen      = input.int(10,   "Pivot length (swing sensitivity)",        minval = 2,  group = grpZ)
maxZones      = input.int(6,    "Max active zones",                        minval = 2,  maxval = 20, group = grpZ)
bigMoveMult   = input.float(1.5,"Big Movement ≥ ATR ×",                    minval = 0.1, step = 0.1, group = grpZ, tooltip = "قانون SNRZ: هر Movement باید بزرگ باشد. حداقل حرکت = ATR × این ضریب")
breakoutPct   = input.float(75, "Breakout rule (%)",                       minval = 50, maxval = 100, group = grpZ, tooltip = "قانون ۷۵٪ کتاب: بدنه + سایه‌ی هم‌جهت باید این درصد بیرون زون بسته شود")
minZoneATR    = input.float(0.15,"Min zone height (ATR ×)",                minval = 0.05, step = 0.05, group = grpZ)
maxZoneATR    = input.float(1.2, "Max zone height (ATR ×)",                minval = 0.2,  step = 0.1,  group = grpZ)
zoneMaxAge    = input.int(400,  "Zone lifetime (bars)",                    minval = 50, group = grpZ)

grpS  = "Signals"
useTrendFilter = input.bool(true,  "Trade only with structure trend (Trend is King)", group = grpS)
maxTouches     = input.int(3,      "Max touches on VALID zone (3-touch rule)", minval = 2, maxval = 4, group = grpS)
showSweeps     = input.bool(false, "Show liquidity Sweep / Run markers",   group = grpS)
showFresh      = input.bool(true,  "Show fresh (not yet valid) zones",     group = grpS)

grpV  = "Style"
colSup   = input.color(color.new(#089981, 88), "Fresh Support",       group = grpV)
colRes   = input.color(color.new(#f23645, 88), "Fresh Resistance",    group = grpV)
colSupV  = input.color(color.new(#089981, 60), "VALID Support",       group = grpV)
colResV  = input.color(color.new(#f23645, 60), "VALID Resistance",    group = grpV)
colInv   = input.color(color.new(#ff9800, 65), "Inversion zone",      group = grpV)
showLbl  = input.bool(true, "Zone labels", group = grpV)

// ─────────────────────────── Core series ───────────────────────────────────
atr = ta.atr(14)
bigMove = atr * bigMoveMult

ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low,  pivotLen, pivotLen)

// Market structure trend
var float lastHigh = na
var float prevHigh = na
var float lastLow  = na
var float prevLow  = na
if not na(ph)
    prevHigh := lastHigh
    lastHigh := ph
if not na(pl)
    prevLow := lastLow
    lastLow := pl
trendUp   = not na(prevHigh) and not na(prevLow) and lastHigh > prevHigh and lastLow > prevLow
trendDown = not na(prevHigh) and not na(prevLow) and lastHigh < prevHigh and lastLow < prevLow

// ─────────────────────────── Zone object ───────────────────────────────────
// role : 1 Support / -1 Resistance     state : 0 fresh, 1 VALID, 2 inversion
type Zone
    float top
    float bot
    int   role
    int   state
    int   touches
    int   sigTouch     // touch number that already produced a signal (anti-spam latch)
    bool  wasValid
    bool  dead         // exhausted (3-touch rule) → keep drawing, no more trades
    int   bornBar
    box   bx
    label lb

var zones = array.new<Zone>()

zoneColor(Zone z) =>
    z.state == 2 ? colInv : z.role == 1 ? (z.state == 1 ? colSupV : colSup) : (z.state == 1 ? colResV : colRes)

// Book naming: a broken zone keeps its ORIGIN name —
//   broken Valid Resistance = I.VR (buy) , broken Valid Support = I.VS (sell)
//   broken fresh Resistance = RBS  (buy) , broken fresh Support = SBR  (sell)
zoneText(Zone z) =>
    string base = na
    if z.role == 1
        base := z.state == 2 ? (z.wasValid ? "I.VR" : "RBS") : z.state == 1 ? "V.S" : "S"
    else
        base := z.state == 2 ? (z.wasValid ? "I.VS" : "SBR") : z.state == 1 ? "V.R" : "R"
    if z.dead
        base := base + " ✗"
    else if z.touches > 0
        base := base + " T" + str.tostring(z.touches)
    base

refreshZone(Zone z) =>
    hidden = z.state == 0 and not showFresh
    c = hidden ? color.new(color.gray, 100) : zoneColor(z)
    box.set_rightbottom(z.bx, bar_index + 6, z.bot)
    box.set_bgcolor(z.bx, c)
    box.set_border_color(z.bx, hidden ? color.new(color.gray, 100) : color.new(c, 30))
    if showLbl
        label.set_xy(z.lb, bar_index + 6, (z.top + z.bot) / 2)
        label.set_text(z.lb, hidden ? "" : zoneText(z))
        label.set_textcolor(z.lb, color.new(zoneColor(z), 0))

newZone(float _top, float _bot, int _role) =>
    h  = _top - _bot
    mn = atr * minZoneATR
    mx = atr * maxZoneATR
    t  = _top
    b  = _bot
    if h < mn
        mid = (t + b) / 2
        t := mid + mn / 2
        b := mid - mn / 2
    if t - b > mx
        if _role == 1
            t := b + mx
        else
            b := t - mx
    bx = box.new(bar_index - pivotLen, t, bar_index + 6, b, border_color = color.new(color.gray, 60), bgcolor = colSup)
    lb = showLbl ? label.new(bar_index + 6, (t + b) / 2, "", style = label.style_label_left, textcolor = color.white, color = color.new(color.black, 100), size = size.small) : label(na)
    Zone.new(t, b, _role, 0, 0, 0, false, false, bar_index, bx, lb)

overlaps(float _top, float _bot) =>
    res = false
    for z in zones
        if not (_bot > z.top or _top < z.bot)
            res := true
            break
    res

killZone(int idx) =>
    Zone z = array.get(zones, idx)
    box.delete(z.bx)
    label.delete(z.lb)
    array.remove(zones, idx)

// ─────────────── Cleanup: age limit + max count ─────────────────────────────
if array.size(zones) > 0
    for i = array.size(zones) - 1 to 0
        Zone z = array.get(zones, i)
        if bar_index - z.bornBar > zoneMaxAge
            killZone(i)
while array.size(zones) > maxZones
    killZone(0)

// ─────────────── Create zones from confirmed pivots ────────────────────────
// First Movement must already be BIG: price must have travelled ≥ bigMove
// away from the pivot before the zone is accepted (yasay Big Movement).
if not na(pl)
    pTop = math.min(open[pivotLen], close[pivotLen])
    pBot = low[pivotLen]
    if (high - pBot) >= bigMove and not overlaps(pTop, pBot)
        array.push(zones, newZone(pTop, pBot, 1))

if not na(ph)
    pTop = high[pivotLen]
    pBot = math.max(open[pivotLen], close[pivotLen])
    if (pTop - low) >= bigMove and not overlaps(pTop, pBot)
        array.push(zones, newZone(pTop, pBot, -1))

// ───────────────── Confirmation candles (SNRZ style) ───────────────────────
bullEngulf = close > open and close[1] < open[1] and close >= open[1]
bearEngulf = close < open and close[1] > open[1] and close <= open[1]
range_  = high - low
bullPin = range_ > 0 and (math.min(open, close) - low) >= 0.6 * range_ and close >= open
bearPin = range_ > 0 and (high - math.max(open, close)) >= 0.6 * range_ and close <= open
bullConfirm = bullEngulf or bullPin
bearConfirm = bearEngulf or bearPin

// ───────────── 75% breakout rule (body + directional shadow) ───────────────
bullBreak75(float lvl) =>
    fullBody = close > lvl and open > lvl
    partial = false
    if close > lvl and not fullBody
        bodyLow = math.min(open, close)
        len = high - bodyLow
        partial := len > 0 and (high - math.max(lvl, bodyLow)) / len * 100 >= breakoutPct
    fullBody or partial

bearBreak75(float lvl) =>
    fullBody = close < lvl and open < lvl
    partial = false
    if close < lvl and not fullBody
        bodyHigh = math.max(open, close)
        len = bodyHigh - low
        partial := len > 0 and (math.min(lvl, bodyHigh) - low) / len * 100 >= breakoutPct
    fullBody or partial

// ─────────────────────── Zone engine ───────────────────────────────────────
bool buySig      = false
bool sellSig     = false
bool po2Buy      = false
bool po2Sell     = false
bool zoneBreakUp = false
bool zoneBreakDn = false

for z in zones
    if bar_index <= z.bornBar
        refreshZone(z)
        continue
    inZone      = low <= z.top and high >= z.bot
    justEntered = inZone and not (low[1] <= z.top and high[1] >= z.bot)

    if z.role == 1
        // ─── SUPPORT ───
        if bearBreak75(z.bot)
            z.wasValid := z.state == 1
            z.role  := -1
            z.state := 2
            z.touches := 0
            z.sigTouch := 0
            z.dead := false
            zoneBreakDn := true
        else if inZone and close >= z.bot and not z.dead
            if justEntered
                z.touches := z.touches + 1
                if z.state == 0 and z.touches >= 2
                    z.state := 1                      // Second Movement → VALID
                if (z.state == 1 and z.touches > maxTouches) or (z.state == 2 and z.touches > 2)
                    z.dead := true                    // 3-touch rule: zone exhausted
            // — tradable only: VALID (touch ≥2) or INVERSION (touch 1–2) —
            tradable = not z.dead and ((z.state == 1 and z.touches >= 2) or (z.state == 2 and z.touches >= 1 and z.touches <= 2))
            okTrend  = not useTrendFilter or trendUp or z.state == 2
            fresh    = z.sigTouch != z.touches        // one signal per touch
            if tradable and okTrend and fresh and bullConfirm and close > z.bot
                z.sigTouch := z.touches
                // PO2 = second touch of an INVERSION zone only (book: "PO2 is
                // marked only on inversion zones; the 2nd touch is Power of
                // Second Touch"). Valid-zone retests are regular V.S entries.
                if z.state == 2 and z.touches == 2
                    po2Buy := true
                else
                    buySig := true
    else
        // ─── RESISTANCE ───
        if bullBreak75(z.top)
            z.wasValid := z.state == 1
            z.role  := 1
            z.state := 2
            z.touches := 0
            z.sigTouch := 0
            z.dead := false
            zoneBreakUp := true
        else if inZone and close <= z.top and not z.dead
            if justEntered
                z.touches := z.touches + 1
                if z.state == 0 and z.touches >= 2
                    z.state := 1
                if (z.state == 1 and z.touches > maxTouches) or (z.state == 2 and z.touches > 2)
                    z.dead := true
            tradable = not z.dead and ((z.state == 1 and z.touches >= 2) or (z.state == 2 and z.touches >= 1 and z.touches <= 2))
            okTrend  = not useTrendFilter or trendDown or z.state == 2
            fresh    = z.sigTouch != z.touches
            if tradable and okTrend and fresh and bearConfirm and close < z.top
                z.sigTouch := z.touches
                if z.state == 2 and z.touches == 2
                    po2Sell := true
                else
                    sellSig := true
    refreshZone(z)

// ───────────────────── Liquidity Sweep / Run (optional) ────────────────────
sweepHigh = showSweeps and not na(lastHigh) and high > lastHigh and close < lastHigh and math.max(open, close) < lastHigh
sweepLow  = showSweeps and not na(lastLow)  and low  < lastLow  and close > lastLow  and math.min(open, close) > lastLow

plotshape(sweepHigh, "Liquidity Sweep High", shape.xcross, location.abovebar, color.new(#f23645, 30), size = size.tiny)
plotshape(sweepLow,  "Liquidity Sweep Low",  shape.xcross, location.belowbar, color.new(#089981, 30), size = size.tiny)

// ───────────────────────────── Signals ─────────────────────────────────────
plotshape(buySig,  "BUY",      shape.triangleup,   location.belowbar, color.new(#089981, 0), size = size.small)
plotshape(sellSig, "SELL",     shape.triangledown, location.abovebar, color.new(#f23645, 0), size = size.small)
plotshape(po2Buy,  "PO2 BUY",  shape.labelup,      location.belowbar, color.new(#089981, 0), size = size.small, text = "PO2", textcolor = color.white)
plotshape(po2Sell, "PO2 SELL", shape.labeldown,    location.abovebar, color.new(#f23645, 0), size = size.small, text = "PO2", textcolor = color.white)

// ───────────────────────────── Alerts ──────────────────────────────────────
alertcondition(buySig or po2Buy,   "SNRZ Buy",        "SNRZ: BUY — rejection at Valid/Inversion Support")
alertcondition(sellSig or po2Sell, "SNRZ Sell",       "SNRZ: SELL — rejection at Valid/Inversion Resistance")
alertcondition(po2Buy,             "SNRZ PO2 Buy",    "SNRZ: Power of Second Touch — BUY")
alertcondition(po2Sell,            "SNRZ PO2 Sell",   "SNRZ: Power of Second Touch — SELL")
alertcondition(zoneBreakUp,        "SNRZ Break Up",   "SNRZ: Resistance broken (75%) → RBS/I.VR buy zone")
alertcondition(zoneBreakDn,        "SNRZ Break Down", "SNRZ: Support broken (75%) → SBR/I.VS sell zone")
