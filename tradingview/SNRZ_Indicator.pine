colSRR   = input.color(color.new(#00e676, 74), "SRR    (S that broke 2 R)", group = grpV)
colRSS   = input.color(color.new(#ff1744, 74), "RSS    (R that broke 2 S)", group = grpV)
colFBA   = input.color(color.new(#ffffff, 80), "FBA    (false-breakout area)", group = grpV)
perName  = input.bool(true, "یک رنگ جدا برای هر نوع زون", group = grpV, tooltip = "خاموش که باشد به همان پنج رنگ قدیمی برمی‌گردد: ساپورت/رزیستنسِ فرش، ساپورت/رزیستنسِ ولید، و طلاییِ اینورژن.")
labelSize = input.string("normal", "اندازه‌ی متنِ اسمِ زون", options = ["tiny", "small", "normal", "large"], group = grpV)
colBuy   = input.color(#00c853, "BUY color",  group = grpV)
colSell  = input.color(#ff1744, "SELL color", group = grpV)
colGold  = input.color(#d4af37, "Accent (Zindan gold)", group = grpV)

// ─────────────────────────── Core series ───────────────────────────────────
atr = ta.atr(14)

// The book marks zones on Weekly / Daily / 4H / 1H and confirms below. The
// analysis timeframe is one rung up the book's own ladder {15m, 1H, 4H, D, W}
// so the stop stays in proportion to the chart being traded.
chartMin = timeframe.in_seconds(timeframe.period) / 60
// The book's own TimeFrames table reads Analysis / SKIP / Confirmation:
//   Weekly · Daily(SKIP) · 4H   |   Daily · 4H(SKIP) · 1H
//   4H · 1H(SKIP) · 30m         |   1H · 30m(SKIP) · 15m
// so the analysis timeframe sits TWO rungs above the chart, with one rung
// deliberately skipped. Measured on 83 days of real XAUUSD that reading is
// clearly worse — on M5, the captain's own favourite, +0.10R falls to +0.02R
// — so the one-rung ladder stays the default and the skip is a switch.
autoOne  = chartMin <= 5 ? "15" : chartMin <= 30 ? "60" : chartMin <= 60 ? "240" : chartMin <= 240 ? "D" : chartMin <= 1440 ? "W" : "M"
autoSkip = chartMin <= 1 ? "15" : chartMin <= 5 ? "30" : chartMin <= 15 ? "60" : chartMin <= 30 ? "240" : chartMin <= 60 ? "D" : "W"
autoHtf  = htfSkipRung ? autoSkip : autoOne
htfTF    = htfIn == "" ? autoHtf : htfIn
htfMin   = timeframe.in_seconds(htfTF) / 60
tfRatio  = math.max(1.0, htfMin / math.max(chartMin, 1.0))

// chart-timeframe pivots — the many small zones the low timeframes trade
phL = ta.pivothigh(high, pivotLtf, pivotLtf)
plL = ta.pivotlow(low,  pivotLtf, pivotLtf)
bodyHiL = math.max(open[pivotLtf], close[pivotLtf])
bodyLoL = math.min(open[pivotLtf], close[pivotLtf])
// The structural band of the pivot itself: the turn it sits in, wick side out
// to the extreme and body side to the closes. Stored with the swing so a later
// pair can widen its zone to cover BOTH turns — that is the shape of the
// captain's 1-hour boxes, and what leaves room for the 15-minute layer.
stK      = math.min(structBars, pivotLtf)
stLoL    = ta.lowest(low, 2 * stK + 1)[pivotLtf - stK]
stHiL    = ta.highest(high, 2 * stK + 1)[pivotLtf - stK]
stBodyHiL= ta.highest(math.max(open, close), 2 * stK + 1)[pivotLtf - stK]
stBodyLoL= ta.lowest(math.min(open, close),  2 * stK + 1)[pivotLtf - stK]
hiRunL  = ta.highest(high, pivotLtf)
loRunL  = ta.lowest(low,  pivotLtf)

// Images 27/28 — the ENGULF zone, method 5 of p24, drawn where the book says:
// «at the place where the wicks have befriended, and whichever candle is
// SHORTER than the one before it». So it needs a real engulfing PAIR around
// the pivot (bearish at a top, bullish at a bottom), and the band is the
// SHORTER candle's body. Returns [na, na] when the pivot has no such pair.
engulfZone(int o, bool isHigh) =>
    float rt = na
    float rb = na
    for k = 0 to 1
        i1 = o + 1 - k                 // the candle that gets engulfed
        i2 = o - k                     // the one that engulfs it
        up = close[i2] > open[i2]
        if (isHigh ? not up : up) and na(rt)
            b1h = math.max(open[i1], close[i1])
            b1l = math.min(open[i1], close[i1])
            b2h = math.max(open[i2], close[i2])
            b2l = math.min(open[i2], close[i2])
            if b2h >= b1h and b2l <= b1l and b2h > b2l
                // "whichever is SHORTER" — measured over the full range, wick
                // included, exactly as the picture shows it
                si = (high[i1] - low[i1]) <= (high[i2] - low[i2]) ? i1 : i2
                // and the zone is that WHOLE candle — body together with its
                // wick, not the body alone
                rt := engulfFullCandle ? high[si] : math.max(open[si], close[si])
                rb := engulfFullCandle ? low[si]  : math.min(open[si], close[si])
    [rt, rb]

// Image 31 tells the reader to use a LINE CHART to see and mark the zones
// better, and images 12/13 print the same chart twice — candles and line —
// with the level sitting on the CLOSE level while the wicks poke through it.
// A level price keeps CLOSING at is invisible to a high/low pivot when every
// spike stops somewhere different, so the line chart gets its own pivot pass.
phLc = ta.pivothigh(close, pivotLtf, pivotLtf)
plLc = ta.pivotlow(close,  pivotLtf, pivotLtf)
hiRunLc = ta.highest(close, pivotLtf)
loRunLc = ta.lowest(close,  pivotLtf)

[engBearTL, engBearBL] = engulfZone(pivotLtf, true)
[engBullTL, engBullBL] = engulfZone(pivotLtf, false)
momBodyL = math.abs(close[pivotLtf] - open[pivotLtf])
// ...and the WHOLE candle, for image 43's momentum zone
momHiL   = high[pivotLtf]
momLoL   = low[pivotLtf]

// analysis-timeframe pivots, structure and ATR
phSrc = ta.pivothigh(high, pivotHtf, pivotHtf)
plSrc = ta.pivotlow(low,  pivotHtf, pivotHtf)
bodyHiSrc = math.max(open[pivotHtf], close[pivotHtf])
bodyLoSrc = math.min(open[pivotHtf], close[pivotHtf])
hiRunSrc = ta.highest(high, pivotHtf)
loRunSrc = ta.lowest(low,  pivotHtf)
[engBearTSrc, engBearBSrc] = engulfZone(pivotHtf, true)
[engBullTSrc, engBullBSrc] = engulfZone(pivotHtf, false)
momBodySrc = math.abs(close[pivotHtf] - open[pivotHtf])
momHiSrc   = high[pivotHtf]
momLoSrc   = low[pivotHtf]
stKh       = math.min(structBars, pivotHtf)
stLoSrc    = ta.lowest(low, 2 * stKh + 1)[pivotHtf - stKh]
stHiSrc    = ta.highest(high, 2 * stKh + 1)[pivotHtf - stKh]
stBodyHiSrc= ta.highest(math.max(open, close), 2 * stKh + 1)[pivotHtf - stKh]
stBodyLoSrc= ta.lowest(math.min(open, close),  2 * stKh + 1)[pivotHtf - stKh]
phLcSrc = ta.pivothigh(close, pivotHtf, pivotHtf)
plLcSrc = ta.pivotlow(close,  pivotHtf, pivotHtf)
hiRunLcSrc = ta.highest(close, pivotHtf)
loRunLcSrc = ta.lowest(close,  pivotHtf)

[phH, plH, bodyHiH, bodyLoH, closeH, atrH, hiRunH, loRunH, engBearTH, engBearBH, engBullTH, engBullBH, momBodyH, momHiH, momLoH, phLcH, plLcH, hiRunLcH, loRunLcH, stLoH, stHiH, stBodyHiH, stBodyLoH] = request.security(syminfo.tickerid, htfTF, [phSrc, plSrc, bodyHiSrc, bodyLoSrc, close[1], atr[1], hiRunSrc, loRunSrc, engBearTSrc, engBearBSrc, engBullTSrc, engBullBSrc, momBodySrc, momHiSrc, momLoSrc, phLcSrc, plLcSrc, hiRunLcSrc, loRunLcSrc, stLoSrc, stHiSrc, stBodyHiSrc, stBodyLoSrc], lookahead = barmerge.lookahead_off)

atrA = na(atrH) ? atr : atrH              // ATR of the analysis timeframe

newPHh = not na(phH) and (na(phH[1]) or phH != phH[1])
newPLh = not na(plH) and (na(plH[1]) or plH != plH[1])

// Trend is read on the ANALYSIS timeframe — "Trend is King" in the book means
// the higher-timeframe trend, and measuring it on a 1m chart made it flip every
// few candles. A close beyond the last confirmed swing IS the structure break.
var float lastHigh = na
var float prevHigh = na
var float lastLow  = na
var float prevLow  = na
// ...unless singleTf is on, in which case there IS no analysis timeframe and
// the chart's own swings are the structure.
newPHt = singleTf ? not na(phL)  : newPHh
newPLt = singleTf ? not na(plL)  : newPLh
phT    = singleTf ? phL          : phH
plT    = singleTf ? plL          : plH
closeT = singleTf ? close        : closeH
atrT   = singleTf ? atr          : atrA
prevHigh := newPHt ? lastHigh : prevHigh
lastHigh := newPHt ? phT : lastHigh
prevLow := newPLt ? lastLow : prevLow
lastLow := newPLt ? plT : lastLow

var int trendState   = 0
var int lastBosUpBar = -99999
var int lastBosDnBar = -99999
bosUp = not na(lastHigh) and not na(closeT) and closeT > lastHigh + atrT * 0.1
bosDn = not na(lastLow)  and not na(closeT) and closeT < lastLow  - atrT * 0.1
bosUpNew = bosUp and not bosUp[1]
bosDnNew = bosDn and not bosDn[1]
if bosUpNew
    lastBosUpBar := bar_index
    trendState   := 1
if bosDnNew
    lastBosDnBar := bar_index
    trendState   := -1
if trendState == 0 and not na(prevHigh) and not na(prevLow)
    if lastHigh > prevHigh and lastLow > prevLow
        trendState := 1
    else if lastHigh < prevHigh and lastLow < prevLow
        trendState := -1
// Chart-structure fallback. Until the analysis timeframe has printed two
// swings it has NO opinion — and with trendState stuck at 0 the filter used to
// block every single trade forever, which is why the 4H chart showed nothing
// at all. "Trend is King" does not mean "no opinion, no trade": when the higher
// timeframe cannot tell, the chart's own last two swings answer instead.
var float cHi     = na
var float cPrevHi = na
var float cLo     = na
var float cPrevLo = na
cPrevHi := not na(phL) ? cHi : cPrevHi
cHi := not na(phL) ? phL : cHi
cPrevLo := not na(plL) ? cLo : cPrevLo
cLo := not na(plL) ? plL : cLo
fbUp = not na(cPrevHi) and not na(cPrevLo) and cHi > cPrevHi and cLo > cPrevLo
fbDn = not na(cPrevHi) and not na(cPrevLo) and cHi < cPrevHi and cLo < cPrevLo
effTrend = trendState != 0 ? trendState : fbUp ? 1 : fbDn ? -1 : 0

// rangeBars counts ANALYSIS bars and bar_index is a CHART index, so the window
// is scaled by the ratio between them — which is 1 when the chart IS the
// analysis timeframe. Leaving the ratio in under singleTf made the window
// several times too wide and held the engine "in range" almost permanently.
rangeSpan = math.round(rangeBars * (singleTf ? 1.0 : tfRatio))
inRange   = (bar_index - lastBosUpBar) <= rangeSpan and (bar_index - lastBosDnBar) <= rangeSpan
trendUp   = effTrend == 1 and not inRange
trendDown = effTrend == -1 and not inRange
// neither timeframe can tell — that is "no opinion", not "no trade"
trendUnknown = effTrend == 0 and not inRange

// ─────────────────────────── Zone object ───────────────────────────────────
type Zone
    float top
    float bot
    int   role       //  1 = support (buy side) · -1 = resistance (sell side)
    int   state      //  0 fresh · 1 VALID (two movements) · 2 inverted
    int   touches
    int   sigTouch
    int   oppBreaks
    int   flips
    int   uid
    bool  htf        //  true = analysis-timeframe zone
    bool  srr
    bool  wasValid
    bool  dead
    bool  paired     //  drawn from TWO swings (p24) — born valid, needs 1 touch
    int   falseBreaks //  how many times broken and respected again
    bool  fba        //  TWO of those = a False Breakout Area
    int   pendBar    //  bar an unconfirmed 75% break happened on
    int   pendDir    //  +1 broke up · -1 broke down · 0 nothing pending
    int   bornBar
    bool  far        //  too far from price to be worth drawing (still a target)
    int   awaitPull  //  broke on this bar, waiting for the pullback swing
    float rawTop     //  the band as the ANALYSIS timeframe drew it, kept only
    float rawBot     //  so the chart can still outline it once it is refined
    bool  refined
    box   bx
    box   bxRaw      //  that outline (na while the zone was never refined)
    line  mid
    // How far price has travelled since this zone broke — the Big Movement the
    // re-anchor waits for. Kept PER ZONE and extended every bar, because
    // ta.highest() cannot do this job: there is one internal state per call
    // site, so a single ta.highest(high, span) inside the zone loop was being
    // asked to serve every awaiting zone at once with a different span each.
    float pullHi
    float pullLo

var zones = array.new<Zone>()

// The name decides the colour, so the same rules that pick the LABEL pick the
// paint. Kept in step with zoneText() below — if one gains a name the other
// has to as well.
zoneColor(Zone z) =>
    color c = z.state == 2 ? colInv : z.role == 1 ? (z.state == 1 or z.srr ? colSupV : colSup) : (z.state == 1 or z.srr ? colResV : colRes)
    if perName
        po2 = z.state == 2 and z.touches == 1
        if z.fba
            c := colFBA
        else if z.state == 2 and po2
            c := z.wasValid ? colPO2i : colPO2
        else if z.state == 2
            c := z.role == 1 ? (z.wasValid ? colIVR : colRBS) : (z.wasValid ? colIVS : colSBR)
        else if z.srr
            c := z.role == 1 ? colSRR : colRSS
    c

txtSize() =>
    labelSize == "tiny" ? size.tiny : labelSize == "small" ? size.small : labelSize == "large" ? size.large : size.normal

zoneText(Zone z) =>
    string base = na
    // Image 44 names "PO2 Fresh" and "PO2 Inversion" as zones in their own
    // right, and the ranking already treats them as the 2nd and 3rd strongest
    // setups there are -- but the label never said so, so the one state the
    // book calls the Power of Second Touch was drawn as a plain RBS / I.VR
    // and was invisible on the chart. An inversion zone touched ONCE is
    // exactly that state: the next touch is the second one. Its ORIGIN picks
    // the name -- valid before the flip gives I.PO2, fresh gives PO2.
    po2 = z.state == 2 and z.touches == 1
    if z.role == 1
        base := z.state == 2 ? (po2 ? (z.wasValid ? "I.PO2" : "PO2") : (z.wasValid ? "I.VR" : "RBS")) : z.srr ? "SRR" : z.state == 1 ? "V.S" : "S"
    else
        base := z.state == 2 ? (po2 ? (z.wasValid ? "I.PO2" : "PO2") : (z.wasValid ? "I.VS" : "SBR")) : z.srr ? "RSS" : z.state == 1 ? "V.R" : "R"
    if z.fba
        base := base + " FBA"
    if z.dead
        base := base + " ✗"
    else if z.touches > 0
        base := base + " T" + str.tostring(z.touches)
    // a zone that has only just formed is the one worth watching — the book's
    // whole method is trading a FRESHLY drawn zone, not one the chart has been
    // carrying for two hundred candles
    if newBars > 0 and not z.dead and bar_index - z.bornBar <= newBars
        base := "🆕 " + base
    z.htf ? base + " ·" + htfTF : base

zoneHidden(Zone z) =>
    // images 39/44: a plain FRESH zone gives no entry and cannot be a target,
    // so it stays off the chart unless you ask for it. An FBA is a good zone
    // even while fresh, so it is never hidden by this rule.
    (z.htf and not showHtf) or (not z.htf and not showLtf) or z.far or (z.state == 0 and not z.srr and not z.fba and not showFresh)

// an analysis zone gets a solid, thicker border, a chart zone a thin one, so
// the two sets stay tellable apart at a glance
refreshZone(Zone z) =>
    hidden = zoneHidden(z)
    c = zoneColor(z)
    // BOTH corners. Only the bottom-right was being refreshed, so a zone that
    // MOVED after it was drawn — a flipped level re-anchored onto its pullback
    // swing, or an analysis band tightened to the chart — kept its original
    // TOP. That is where the oversized boxes on the 15m and 1h charts came
    // from: the bottom followed the new level and the top stayed behind.
    box.set_lefttop(z.bx, box.get_left(z.bx), z.top)
    box.set_rightbottom(z.bx, bar_index + 10, z.bot)
    box.set_bgcolor(z.bx, hidden ? color.new(color.gray, 100) : c)
    box.set_border_color(z.bx, hidden ? color.new(color.gray, 100) : color.new(c, z.htf ? 15 : 45))
    box.set_border_width(z.bx, z.htf ? 2 : 1)
    box.set_border_style(z.bx, z.state == 0 and not z.srr ? line.style_dashed : line.style_solid)
    box.set_text(z.bx, hidden ? "" : zoneText(z))
    box.set_text_color(z.bx, hidden ? color.new(color.gray, 100) : color.new(c, 0))
    box.set_text_size(z.bx, txtSize())
    box.set_text_halign(z.bx, text.align_right)
    // ...and the midline needs BOTH ends, for the same reason. Setting only
    // xy2 left the left end at the old middle, which is why the dashed line
    // ran diagonally across the box instead of through the middle of it.
    line.set_xy1(z.mid, line.get_x1(z.mid), (z.top + z.bot) / 2)
    line.set_xy2(z.mid, bar_index + 10, (z.top + z.bot) / 2)
    line.set_color(z.mid, hidden ? color.new(color.gray, 100) : color.new(c, 55))
    // the wide analysis band the tight one was carved out of — outline only,
    // so you can still see where the 1-hour chart saw the level
    if not na(z.bxRaw)
        box.set_lefttop(z.bxRaw, box.get_left(z.bxRaw), z.rawTop)
        box.set_rightbottom(z.bxRaw, bar_index + 10, z.rawBot)
        box.set_border_color(z.bxRaw, hidden ? color.new(color.gray, 100) : color.new(c, 60))

// The captain's middle layer, in code:
//   «وقتی زون بزرگ در ۱۵ دقیقه مشخص شد و به ۱ دقیقه می‌روی، آن زون کوچک‌تر
//    می‌شود چون کندل‌ها کوچک‌ترند. در یک دقیقه آن زونِ ۱۵ دقیقه برداشته می‌شود
//    و روی زونی که یک دقیقه مشخص کرده حساب می‌شود.»
// The key is WHICH candles redraw it. Not price coming back later — the
// 15-minute zone and the 1-minute zone are drawn from THE SAME MINUTES at a
// finer resolution. One 15-minute candle with a five-dollar wick is fifteen
// 1-minute candles and the turn itself only used three of them. So the chart
// candles that built this analysis band are re-read, the one holding the
// extreme is found, and the band is redrawn around ITS little cluster with the
// ordinary SNRZ geometry: wick side out to the extreme, body side in.
refineFromChart(float _top, float _bot, int _role) =>
    // the analysis pivot needs pivotHtf bars each side to confirm, so its turn
    // lies within that many analysis bars of chart candles
    int span = math.min(400, int(math.round(tfRatio)) * (2 * pivotHtf + 1))
    int   best   = -1
    float bestPx = na
    for i = 0 to span
        if high[i] >= _bot and low[i] <= _top
            px = math.max(_bot, math.min(_top, _role == 1 ? low[i] : high[i]))
            if na(bestPx) or (_role == 1 ? px < bestPx : px > bestPx)
                best   := i
                bestPx := px
    float t = _top
    float b = _bot
    if best >= 0
        int k  = structBars
        int lo = math.max(0, best - k)
        int hi = math.min(span, best + k)
        float ex   = na          // the extreme  (wick side)
        float body = na          // the closes   (body side)
        for i = lo to hi
            e = _role == 1 ? low[i] : high[i]
            y = _role == 1 ? math.max(open[i], close[i]) : math.min(open[i], close[i])
            ex   := na(ex)   ? e : (_role == 1 ? math.min(ex, e)     : math.max(ex, e))
            body := na(body) ? y : (_role == 1 ? math.max(body, y)   : math.min(body, y))
        if _role == 1
            b := math.max(_bot, ex)
            t := math.min(_top, body)
        else
            t := math.min(_top, ex)
            b := math.max(_bot, body)
        mn = atr * minZoneATR
        if t - b < mn                    // still a zone, not a hair line
            m = (t + b) / 2
            t := math.min(_top, m + mn / 2)
            b := math.max(_bot, m - mn / 2)
        if t <= b or t - b >= _top - _bot
            t := _top                    // no tighter than it already was
            b := _bot
    [t, b]

newZone(float _top, float _bot, int _role, bool _htf, int _uid, float _atr, int _back, bool _paired) =>
    h  = _top - _bot
    mn = _atr * minZoneATR
    // the analysis zones take their shape from the structure, so their cap is
    // only a sanity bound
    mx = _atr * (_htf ? maxZoneATRHtf : maxZoneATR)
    t  = _top
    b  = _bot
    if h < mn
        m = (t + b) / 2
        t := m + mn / 2
        b := m - mn / 2
    if t - b > mx
        if _role == 1
            t := b + mx
        else
            b := t - mx
    float rawT = t
    float rawB = b
    if _htf and refineHtf
        [rt, rb] = refineFromChart(t, b, _role)
        t := rt
        b := rb
    bool wasRef = t != rawT or b != rawB
    x1 = bar_index - _back
    bx = box.new(x1, t, bar_index + 10, b, border_color = color.new(color.gray, 60), bgcolor = colSup)
    // NOT a ternary: `?:` evaluates both branches, so box.new() would run and
    // leak a box on every unrefined zone
    box bxr = na
    if wasRef
        bxr := box.new(x1, rawT, bar_index + 10, rawB, border_color = color.new(color.gray, 60), bgcolor = color.new(color.gray, 100), border_style = line.style_dotted)
    md = line.new(x1, (t + b) / 2, bar_index + 10, (t + b) / 2, style = line.style_dashed, color = color.new(color.gray, 55))
    // a paired zone already HAS its two movements (p35), so it is born VALID
    //                                    touches=0, sigTouch=-1
    // sigTouch is "the touch count this zone has already produced an order
    // for", so it must start at a value no touch count can equal. Born at 0 it
    // matched the zone's own 0 touches and the zone was blocked from arming
    // for its entire life — every zone, from the moment it was drawn.
    Zone.new(t, b, _role, _paired ? 1 : 0, 0, -1, 0, 0, _uid, _htf, false, false, false, _paired, 0, false, -1, 0, bar_index, false, -1, rawT, rawB, wasRef, bx, bxr, md, na, na)

// Overlap is checked WITHIN a set only — a small chart zone is expected to sit
// inside a big analysis zone. An exhausted zone reserves nothing: the book says
// once a zone has had its touches you redraw.
overlaps(float _top, float _bot, bool _htf) =>
    res = false
    for z in zones
        if z.htf == _htf and not z.dead and not (_bot > z.top or _top < z.bot)
            res := true
            break
    res

killZone(int idx) =>
    Zone z = array.get(zones, idx)
    box.delete(z.bx)
    if not na(z.bxRaw)
        box.delete(z.bxRaw)
    line.delete(z.mid)
    array.remove(zones, idx)

// ─────────────── Cleanup: lifetime, distance, capacity per set ─────────────
lifeHtfBars = lifeHtf * tfRatio
if array.size(zones) > 0
    for i = array.size(zones) - 1 to 0
        Zone z = array.get(zones, i)
        age  = bar_index - z.bornBar
        life = z.htf ? lifeHtfBars : lifeLtf
        ref  = z.htf ? atrA : atr
        gap  = close > z.top ? close - z.top : close < z.bot ? z.bot - close : 0.0
        // A zone dies when the market BREAKS it. Age and distance no longer
        // delete anything: the book never retires a level by the clock, and a
        // level far overhead is exactly what a running trade is aiming AT.
        // Distance now only HIDES the box (see zoneHidden), so a far target
        // stops cluttering the chart while still counting as a target.
        z.far := not na(ref) and gap > ref * maxZoneDistATR
        if (expireByAge and age > life) or (dropFar and z.far) or (dropDead and z.dead)
            killZone(i)

// each set has its own capacity; exhausted zones are evicted before live ones
cntLtf = 0
cntHtf = 0
for z in zones
    if z.htf
        cntHtf += 1
    else
        cntLtf += 1

while cntLtf > maxZonesLtf or cntHtf > maxZonesHtf
    dropHtf = cntHtf > maxZonesHtf
    int victim = -1
    for i = 0 to array.size(zones) - 1
        Zone zv = array.get(zones, i)
        if zv.htf == dropHtf and zv.dead
            victim := i
            break
    if victim < 0
        for i = 0 to array.size(zones) - 1
            Zone zv = array.get(zones, i)
            if zv.htf == dropHtf
                victim := i
                break
    if victim < 0
        break
    killZone(victim)
    if dropHtf
        cntHtf -= 1
    else
        cntLtf -= 1

// ─────────────── Create zones — BOTH sets, as the book does ────────────────
// p24: four of the five drawing methods pair TWO swing points at a similar
// price (S+S, R+R, S+R, R+S) — the zone is the band the two of them bracket.
// The swings of each set are remembered so a later one can find its mate.
var ltfSwPrice = array.new<float>()
var ltfSwHigh  = array.new<bool>()
var ltfSwBar   = array.new<int>()
var ltfSwLine  = array.new<bool>()
var ltfStLo    = array.new<float>()
var ltfStHi    = array.new<float>()
var htfSwPrice = array.new<float>()
var htfSwHigh  = array.new<bool>()
var htfSwBar   = array.new<int>()
var htfSwLine  = array.new<bool>()
var htfStLo    = array.new<float>()
var htfStHi    = array.new<float>()
// Image 35: a valid zone has a FIRST movement as well as a second one, and
// "the more each of the movements is momentum, the more the market respects
// that zone". These hold, for every remembered swing, how far price has run
// away from it SO FAR — measured up to the pivot bar, so the second movement
// (which is checked separately) cannot pay for the first one.
var ltfSegHi = array.new<float>()
var ltfSegLo = array.new<float>()
var htfSegHi = array.new<float>()
var htfSegLo = array.new<float>()
// The analysis swings must measure their gap in ANALYSIS bars. Passing
// bar_index here compared a 4H swing distance against a 60-CHART-bar limit,
// so on a 1H chart two 4H swings 20 bars apart looked 80 apart and almost
// never paired — which is why the panel kept reading "0 @ 240".
var int htfBarNo = 0
if newPHh or newPLh
    htfBarNo += 1

// returns the index of the newest earlier swing at a similar price, or -1
findMate(bool _htf, float _price, int _bar, float _atr, bool _line) =>
    aP = _htf ? htfSwPrice : ltfSwPrice
    aB = _htf ? htfSwBar   : ltfSwBar
    aL = _htf ? htfSwLine  : ltfSwLine
    tol = _atr * pairTolATR
    int found = -1
    n = array.size(aP)
    if n > 0
        first = math.max(0, n - pairLookback)
        for i = n - 1 to first
            // a CLOSE pivot may only pair with another close pivot: mixing the
            // two would be gluing a line chart onto a candle chart
            if array.get(aL, i) == _line and _bar - array.get(aB, i) <= pairMaxGap and math.abs(array.get(aP, i) - _price) <= tol
                found := i
                break
    found

pushSwing(bool _htf, float _price, bool _isHigh, int _bar, float _segHi, float _segLo, bool _line, float _stLo, float _stHi) =>
    aP = _htf ? htfSwPrice : ltfSwPrice
    aH = _htf ? htfSwHigh  : ltfSwHigh
    aB = _htf ? htfSwBar   : ltfSwBar
    aL = _htf ? htfSwLine  : ltfSwLine
    sH = _htf ? htfSegHi   : ltfSegHi
    sL = _htf ? htfSegLo   : ltfSegLo
    tL = _htf ? htfStLo    : ltfStLo
    tH = _htf ? htfStHi    : ltfStHi
    array.push(tL, _stLo)
    array.push(tH, _stHi)
    array.push(aP, _price)
    array.push(aH, _isHigh)
    array.push(aB, _bar)
    array.push(aL, _line)
    array.push(sH, _segHi)
    array.push(sL, _segLo)
    if array.size(aP) > 60
        array.shift(aP)
        array.shift(aH)
        array.shift(aB)
        array.shift(aL)
        array.shift(sH)
        array.shift(sL)
        array.shift(tL)
        array.shift(tH)

// Every bar, each remembered swing's first-movement extreme is extended by the
// candle that has just become a PIVOT candidate — `high[_back]`, not `high` —
// so the reading stops exactly at the pivot bar the next zone is drawn from.
extendSeg(bool _htf, int _back) =>
    sH = _htf ? htfSegHi  : ltfSegHi
    sL = _htf ? htfSegLo  : ltfSegLo
    lf = _htf ? htfSwLine : ltfSwLine
    n  = array.size(sH)
    if n > 0
        h  = high[_back]
        l  = low[_back]
        cl = close[_back]
        for i = 0 to n - 1
            // a LINE swing has no wicks, so its movement is measured close to
            // close — reading high/low here measured the first movement on a
            // chart the zone was never drawn from
            bool isLn = array.get(lf, i)
            array.set(sH, i, math.max(array.get(sH, i), isLn ? cl : h))
            array.set(sL, i, math.min(array.get(sL, i), isLn ? cl : l))

// A broken level only becomes tradable where the PULLBACK turns. The captain's
// 30m chart: an R at 4,433.9 breaks upward, price runs to 4,530, then pulls
// back and prints an S at ~4,460. That S — not the old band, which price never
// revisits — is the buy. So a flipped zone waits here for the first swing of
// the matching kind on the correct side of the break, and MOVES onto it. The
// zone keeps its uid and wasValid, so it is still named I.VR / RBS as before.
reanchorFlipped(float _price, bool _isHigh, float _atr, bool _htf) =>
    if flipNeedsPullback and array.size(zones) > 0
        for i = 0 to array.size(zones) - 1
            Zone z = array.get(zones, i)
            if z.awaitPull >= 0 and not z.dead and z.htf == _htf and bar_index > z.awaitPull
                wantLow = z.role == 1
                if wantLow != _isHigh
                    // a pullback that cuts back through the old level is a
                    // failed break, which the false-breakout path handles
                    ok = wantLow ? _price >= z.bot : _price <= z.top
                    // and the retracement must follow a real move away
                    // This read ta.highest(high, span) / ta.lowest(low, span),
                    // and TWO things were wrong with it — only one of which
                    // raised a warning. ta.* inside a ternary does not run on
                    // every bar, so its history goes inconsistent; and, worse,
                    // ONE call site cannot serve many zones at once, because
                    // Pine keeps a single internal state per call and every
                    // awaiting zone has a different span. The run away from
                    // the break is tracked on the zone itself now.
                    gone = wantLow ? nz(z.pullHi, high) - z.top : z.bot - nz(z.pullLo, low)
                    if ok and (not needBigMove or gone >= _atr * bigMoveMult)
                        half = math.max(_atr * minZoneATR, syminfo.mintick) / 2
                        z.top := _price + half
                        z.bot := _price - half
                        z.bornBar := bar_index
                        z.awaitPull := -1
                        // ...and the DRAWING has to move with it. refreshZone
                        // preserves whatever left edge the box already has, so
                        // a re-anchored zone kept the left edge of the level it
                        // used to be — hundreds of bars back, at a price it no
                        // longer sits at. That is the over-long box: the band
                        // was stretched across history it was never at.
                        box.set_left(z.bx, bar_index)
                        line.set_xy1(z.mid, bar_index, (z.top + z.bot) / 2)
                        if not na(z.bxRaw)
                            box.set_left(z.bxRaw, bar_index)

// one swing -> at most one zone, drawn with its mate when pairing is on
addSwing(bool _htf, float _price, bool _isHigh, int _bar, int _back, float _atr, float _bodyHi, float _bodyLo, float _hiRun, float _loRun, int _uid, float _engT, float _engB, float _momBody, float _momHi, float _momLo, bool _line, float _stLo, float _stHi) =>
    reanchorFlipped(_price, _isHigh, _atr, _htf)
    mate = findMate(_htf, _price, _bar, _atr, _line)
    mi   = pairZones ? mate : -1
    // an if-block, NOT a ternary: Pine evaluates both sides of `?:`, so an
    // array.get() there throws on an empty array even in the branch that is
    // not taken.
    float matePrice = na
    bool  mateHigh  = false
    float mateSegHi = na
    float mateSegLo = na
    float mateStLo  = na
    float mateStHi  = na
    if mi >= 0
        matePrice := array.get(_htf ? htfSwPrice : ltfSwPrice, mi)
        mateHigh  := array.get(_htf ? htfSwHigh  : ltfSwHigh,  mi)
        // read BEFORE the push: a push that trims the array shifts every index
        mateSegHi := array.get(_htf ? htfSegHi : ltfSegHi, mi)
        mateSegLo := array.get(_htf ? htfSegLo : ltfSegLo, mi)
        mateStLo  := array.get(_htf ? htfStLo  : ltfStLo,  mi)
        mateStHi  := array.get(_htf ? htfStHi  : ltfStHi,  mi)
    pushSwing(_htf, _price, _isHigh, _bar, _price, _price, _line, _stLo, _stHi)

    // A GAP mate is the OPPOSITE kind of swing at a DIFFERENT price, so the
    // same-price search above can never find one — it needs its own pass.
    int gi = -1
    if gapZones and (_htf or not gapHtfOnly)
        gP = _htf ? htfSwPrice : ltfSwPrice
        gH = _htf ? htfSwHigh  : ltfSwHigh
        gB = _htf ? htfSwBar   : ltfSwBar
        glo = _atr * gapMinATR
        ghi = _atr * gapMaxATR
        gn  = array.size(gP)
        if gn > 1
            gfirst = math.max(0, gn - pairLookback - 1)
            for i = gn - 2 to gfirst
                gd = math.abs(array.get(gP, i) - _price)
                if array.get(_htf ? htfSwLine : ltfSwLine, i) == _line and _bar - array.get(gB, i) <= pairMaxGap and array.get(gH, i) != _isHigh and gd >= glo and gd <= ghi
                    gi := i
                    break
    if gi >= 0
        gp = array.get(_htf ? htfSwPrice : ltfSwPrice, gi)
        gt = math.max(gp, _price)
        gb = math.min(gp, _price)
        // images 31/33: which side we trade the gap from is decided by where
        // price IS — above the band it is support underneath, below it is
        // resistance overhead. While price stands INSIDE the band there is no
        // side yet, and images 52/53 both draw the box with price already
        // outside it and wait for the return. The old midpoint tie-break gave
        // such a band a side by accident.
        grole = close > gt ? 1 : close < gb ? -1 : 0
        if grole != 0 and not overlaps(gt, gb, _htf)
            array.push(zones, newZone(gt, gb, grole, _htf, _uid, _atr, _back, true))
    else if mi >= 0
        t = math.max(matePrice, _price)
        b = math.min(matePrice, _price)
        int role = 0
        if _isHigh and mateHigh
            role := -1                       // R+R
        else if not _isHigh and not mateHigh
            role := 1                        // S+S
        else
            // S+R / R+S — the GAP band (p51). Which side we trade it from
            // depends on where price is standing now.
            role := close > (t + b) / 2 ? 1 : -1
        // image 36: the move AWAY must be big, or the market has no reason to
        // respect the zone — and image 35: so must the FIRST movement, the one
        // between the two touches.
        // "if ONE of them, the first movement or the second, is bigger, it is
        // BETTER" — one, not both, and better, not required. This used to
        // reject any zone unless BOTH cleared the threshold.
        away  = role == 1 ? _hiRun - t : b - _loRun
        first = role == 1 ? mateSegHi - t : b - mateSegLo
        bigA  = away >= _atr * bigMoveMult
        bigF  = not na(first) and first >= _atr * bigMoveMult
        okBig = bigMoveRule == "off" ? true : bigMoveRule == "both" ? (bigA and bigF) : (bigA or bigF)
        // The analysis zone is drawn from the STRUCTURE of both turns, not as
        // a hairline through two swing prices: wick side out to the extreme,
        // body side to the closes. That is the shape of the captain's 1-hour
        // boxes, and what leaves the 15-minute layer something to tighten.
        if structZone and _htf and not _line and not na(mateStLo)
            if role == 1
                b := math.min(b, math.min(_stLo, mateStLo))
                t := math.max(t, math.max(_stHi, mateStHi))
            else
                t := math.max(t, math.max(_stHi, mateStHi))
                b := math.min(b, math.min(_stLo, mateStLo))
        if not overlaps(t, b, _htf) and okBig
            array.push(zones, newZone(t, b, role, _htf, _uid, _atr, _back, true))
    else if _line
        // The captain's own 15m line chart, tagged by hand: EVERY swing that
        // makes a peak carries an R and every swing that makes a trough an S.
        // No size filter and no higher-high rule — on that chart the second R
        // sits BELOW the first. So an unpaired line swing is still a level: a
        // plain FRESH S/R, which image 39 will not enter and image 44 will not
        // aim at until it earns its second touch. It matters past the drawing:
        // SBR/RBS are what a PLAIN level becomes when it breaks.
        if lineSingleLevels and not overlaps(_price, _price, _htf)
            array.push(zones, newZone(_price, _price, _isHigh ? -1 : 1, _htf, _uid, _atr, _back, false))
    else
        // p24 method 5, and ONLY the two things the book actually draws on a
        // single swing: the ENGULF pair (images 27/28, shorter candle) and the
        // MOMENTUM candle (image 43, "in 80% of cases the market repeats from
        // it"). Until v9.7 this branch drew a zone at EVERY unpaired pivot —
        // a rule that is nowhere in the book, and 70% of all zones came from
        // it. A pivot that is neither an engulf nor a momentum candle now gets
        // nothing. An unpaired zone is born FRESH: it still owes its touches.
        float ft = na
        float fb = na
        if engulfZones and not na(_engT)
            ft := _engT
            fb := _engB
        else if momentumZones and _momBody >= _atr * momBodyATR
            // Image 43 boxes the WHOLE candle — body together with both wicks,
            // exactly as the engulf rule does. Taking only the wick side left
            // the zone a sliver on top of a candle whose whole point is its
            // body. Confirmed by the captain.
            if momFullCandle and not na(_momHi)
                ft := _momHi
                fb := _momLo
            else
                ft := _isHigh ? _price   : _bodyLo
                fb := _isHigh ? _bodyHi  : _price
        if not na(ft) and ft > fb
            away = _isHigh ? ft - _loRun : _hiRun - fb
            if away >= _atr * bigMoveMult and not overlaps(ft, fb, _htf)
                array.push(zones, newZone(ft, fb, _isHigh ? -1 : 1, _htf, _uid, _atr, _back, false))

// The first-movement readings are extended BEFORE this bar's swings are drawn,
// so a zone born now measures the run right up to its own pivot bar.
htfBackSeg = math.min(200, int(math.round(pivotHtf * tfRatio)))
extendSeg(false, pivotLtf)
extendSeg(true,  htfBackSeg)

// ...and so is the run away from a BROKEN level, for the same reason: the
// re-anchor below asks how far price travelled since the break, and it has to
// be current as of this bar. Unconditional, one running extreme per zone —
// which is exactly what a shared ta.highest() could not give it.
for z in zones
    if z.awaitPull >= 0 and not z.dead
        z.pullHi := math.max(nz(z.pullHi, high), high)
        z.pullLo := math.min(nz(z.pullLo, low),  low)

// chart timeframe: the many small zones that give TP1 and the low-timeframe
// setups (book p.44: "let TP1 be a 5-minute zone")
if not na(plL)
    addSwing(false, plL, false, bar_index - pivotLtf, pivotLtf, atr, bodyHiL, bodyLoL, hiRunL, loRunL, bar_index * 8 + 0, engBullTL, engBullBL, momBodyL, momHiL, momLoL, false, stLoL, stBodyHiL)
if not na(phL)
    addSwing(false, phL, true,  bar_index - pivotLtf, pivotLtf, atr, bodyHiL, bodyLoL, hiRunL, loRunL, bar_index * 8 + 1, engBearTL, engBearBL, momBodyL, momHiL, momLoL, false, stBodyLoL, stHiL)

// Images 16/17 — Pump Base Pump / Dump Base Dump. A strong impulse, then a
// tight sideways BASE, then the same move continues: the base is the
// continuation zone. This needs no pivot, so it is checked every bar rather
// than from addSwing. Same arithmetic as SnrzEngine._base_zone().
// ta.* has to run on EVERY bar to stay consistent, so the readings are taken
// unconditionally and only the decision is guarded.
bTop = ta.highest(high, baseMinBars)
bBot = ta.lowest(low,  baseMinBars)
// ...and the impulse that led INTO it, the bars just before the base
iTop = ta.highest(high, baseImpulseBars)[baseMinBars]
iBot = ta.lowest(low,   baseImpulseBars)[baseMinBars]
if baseZones
    if not na(iTop) and not na(iBot) and bTop - bBot <= atr * baseMaxATR
        rise = bTop - iBot
        fall = iTop - bBot
        need = atr * baseImpulseATR
        int brole = rise >= need and rise >= fall ? 1 : fall >= need ? -1 : 0
        if brole != 0 and not overlaps(bTop, bBot, false)
            // the base already IS the two movements, so it is born VALID
            zb = newZone(bTop, bBot, brole, false, bar_index * 8 + 6, atr, baseMinBars - 1, true)
            array.push(zones, zb)

// the LINE CHART's own zones — closes only, on the chart timeframe (image 31)
if lineZones and not na(plLc)
    addSwing(false, plLc, false, bar_index - pivotLtf, pivotLtf, atr, bodyHiL, bodyLoL, hiRunLc, loRunLc, bar_index * 8 + 4, na, na, 0.0, na, na, true, na, na)
if lineZones and not na(phLc)
    addSwing(false, phLc, true,  bar_index - pivotLtf, pivotLtf, atr, bodyHiL, bodyLoL, hiRunLc, loRunLc, bar_index * 8 + 5, na, na, 0.0, na, na, true, na, na)

// analysis timeframe: the few big zones that set the trend and TP2.
// singleTf skips this whole block — the chart marks, confirms and trades on
// itself, so there is no second set of zones to draw.
htfBack = htfBackSeg
if not singleTf and newPLh and not na(atrH)
    addSwing(true, plH, false, htfBarNo, htfBack, atrA, bodyHiH, bodyLoH, hiRunH, loRunH, bar_index * 8 + 2, engBullTH, engBullBH, momBodyH, momHiH, momLoH, false, stLoH, stBodyHiH)
if not singleTf and newPHh and not na(atrH)
    addSwing(true, phH, true,  htfBarNo, htfBack, atrA, bodyHiH, bodyLoH, hiRunH, loRunH, bar_index * 8 + 3, engBearTH, engBearBH, momBodyH, momHiH, momLoH, false, stBodyLoH, stHiH)

// ...and the line chart of the analysis timeframe
newPHlc = lineZones and not na(phLcH) and (na(phLcH[1]) or phLcH != phLcH[1])
newPLlc = lineZones and not na(plLcH) and (na(plLcH[1]) or plLcH != plLcH[1])
if not singleTf and newPLlc and not na(atrH)
    addSwing(true, plLcH, false, htfBarNo, htfBack, atrA, bodyHiH, bodyLoH, hiRunLcH, loRunLcH, bar_index * 8 + 6, na, na, 0.0, na, na, true, na, na)
if not singleTf and newPHlc and not na(atrH)
    addSwing(true, phLcH, true,  htfBarNo, htfBack, atrA, bodyHiH, bodyLoH, hiRunLcH, loRunLcH, bar_index * 8 + 7, na, na, 0.0, na, na, true, na, na)

// The limit-order model needs no confirmation candle: the book puts the order
// ON the zone before price arrives, and the fill IS the entry. The old
// engulf/pin/micro-BOS gates only applied to the "wait for a rejection then
// enter" flow, which this no longer uses.

// ───────────── 75% breakout rule (body + directional shadow only) ──────────
bullBreak75(float lvl) =>
    fullBody = close > lvl and open > lvl
    partial = false
    if close > lvl and not fullBody
        bodyLow = math.min(open, close)
        len = high - bodyLow
        partial := len > 0 and (high - math.max(lvl, bodyLow)) / len * 100 >= breakoutPct
    fullBody or partial

bearBreak75(float lvl) =>
    fullBody = close < lvl and open < lvl
    partial = false
    if close < lvl and not fullBody
        bodyHigh = math.max(open, close)
        len = bodyHigh - low
        partial := len > 0 and (math.min(lvl, bodyHigh) - low) / len * 100 >= breakoutPct
    fullBody or partial

// ───────────── Orders and trades — ONE PER ZONE ────────────────────────────
// The book stacks zones up the chart and puts an order on each one, and each
// order aims at the NEXT zone. A single-slot engine could never do that, so
// this keeps a list: stat -9 is a resting limit, 0 a live trade.
type Ord
    bool   buy
    bool   po2
    int    uid
    int    bar
    float  entry
    float  sl
    float  tp1
    float  tp2
    float  tp3
    string zone
    int    stat      // -9 resting · 0 running · 1/2/3 TP hit · -1 SL · -2 BE
    bool   be
    bool   swing
    float  risk0

var orders = array.new<Ord>()

hasOrder(int _uid) =>
    bool found = false
    for o in orders
        if o.uid == _uid and (o.stat == -9 or o.stat == 0)
            found := true
            break
    found

liveCount() =>
    int n = 0
    for o in orders
        if o.stat == -9 or o.stat == 0
            n += 1
    n

// The captain's middle timeframe, in code. He marks a zone on the 1-hour,
// drops to the 15-minute and draws a SMALLER zone INSIDE it, then confirms on
// the 5-minute. So when chart swings print inside an analysis zone, that zone
// is re-drawn as the band those swings bracket — the same "band between two
// points" rule as everywhere else in SNRZ, one level down. It happens once, on
// the second inner swing, and only while the zone is untouched and carries no
// order: moving a band an order already rests on would move the trade after
// the fact.
// Master class image 44 names exactly which zones may BE a target:
// "V.S, V.R, PO2 Fresh, PO2 Inversion, False breakout area". A plain untested
// S/R, an SBR/RBS or an SRR/RSS is a place to enter FROM, not to aim AT.
canBeTarget(Zone z) =>
    z.state == 1 or z.state == 2 or z.fba

// the opposite-role zone levels lying ahead of the entry, nearest first
nextZone(bool _isBuy, float _entry, int _rank) =>
    float best = na
    float prev = na
    for r = 0 to _rank
        float cur = na
        for z in zones
            if z.dead or not canBeTarget(z)
                continue
            lvl = _isBuy ? z.bot : z.top
            ahead = _isBuy ? (z.role == -1 and lvl > _entry) : (z.role == 1 and lvl < _entry)
            if not ahead
                continue
            if not na(prev) and (_isBuy ? lvl <= prev : lvl >= prev)
                continue
            if na(cur) or (_isBuy ? lvl < cur : lvl > cur)
                cur := lvl
        best := cur
        prev := cur
        if na(cur)
            break
    best

// How many separate LEVELS a set of broken zones represents. Zones drawn by
// the candle pass, the line pass and the analysis pass sit on top of each
// other, so three zones giving way together is usually one level, not three.
distinctLevels(array<float> px, float _atr) =>
    n = array.size(px)
    int out = 0
    if n > 0
        arr = array.copy(px)
        array.sort(arr, order.ascending)
        tol = _atr * pairTolATR
        float last = na
        for i = 0 to array.size(arr) - 1
            v = array.get(arr, i)
            if na(last) or v - last > tol
                out += 1
                last := v
    out

// ─────────────────────── Zone engine ───────────────────────────────────────
bool buySig      = false
bool sellSig     = false
bool po2Buy      = false
bool po2Sell     = false
bool zoneBreakUp = false
bool zoneBreakDn = false
// p25: "it MUST break TWO supports; if it breaks more, that is no problem" —
// so what is counted is LEVELS, not bars. These were plain booleans, so one
// impulse through three resistances credited a support with a single break.
// The prices are collected rather than counted, because the same real level is
// usually carried by several zones at once (the candle pass, the line pass and
// the analysis pass each draw their own) and overlaps() only keeps them apart
// WITHIN a set.
brokeResPx = array.new<float>()
brokeSupPx = array.new<float>()

var int lastSigBar = -1
canFire = liveCount() < maxOpen

// p14: the small zone sits INSIDE the big one
nested(Zone z) =>
    bool res = z.htf
    if not res
        for h in zones
            if h.htf and not h.dead and h.role == z.role and z.bot <= h.top and z.top >= h.bot
                res := true
                break
    res


// Book, liquidity section: "in gold the sell-side liquidity is usually taken
// first and THEN the real move — about 80% of the time". A sell placed right
// after price has just swept a multi-week low is selling the reversal itself.
// On the real H4 data this fired 4 bars after the 3942 bottom and the market
// then ran 600 points the other way.
// see the tooltip: one number cannot serve a 1-minute and a 5-minute chart,
// because this is counted in BARS and a bar is not a fixed amount of market
// time. The fast chart loosens it; everything above keeps its own value.
sweepRecentEff = chartMin <= 1 ? 3 : sweepRecent
// `and` short-circuits, so with the guard switched off these ta.* calls were
// skipped entirely and their history went stale — then the first bar the guard
// came back on read a rolling extreme built from gaps. Pine warns about this
// ("might not execute on every bar"). Taken every bar, unconditionally, and
// the guard is applied afterwards to the plain numbers.
recentLo = ta.lowest(low,   sweepRecentEff)
recentHi = ta.highest(high, sweepRecentEff)
spanLo   = ta.lowest(low,   sweepBars)
spanHi   = ta.highest(high, sweepBars)
sweptLow  = sweepGuard and recentLo <= spanLo
sweptHigh = sweepGuard and recentHi >= spanHi

for z in zones
    if bar_index <= z.bornBar
        refreshZone(z)
        continue
    inZone      = low <= z.top and high >= z.bot
    justEntered = inZone and not (low[1] <= z.top and high[1] >= z.bot)

    if z.role == 1
        if z.pendDir == 0 and bearBreak75(z.bot)
            z.pendBar := bar_index
            z.pendDir := -1                       // wait — does the break HOLD?
        else if z.pendDir == -1
            if close >= z.bot                     // came back: p47 False Breakout
                z.pendBar := -1
                z.pendDir := 0
                // 2026 master class, "FALSE BREAKOUT AREA": the area the
                // market has broken TWICE and then respected again. One
                // failed break is not an FBA — it takes two.
                z.falseBreaks := z.falseBreaks + 1
                z.fba  := z.falseBreaks >= 2
                z.dead := false
            else if bar_index - z.pendBar >= fbaBars
                z.wasValid := z.state == 1
                z.role  := -1
                z.state := 2
                z.awaitPull := flipNeedsPullback ? bar_index : -1
                z.pullHi := high
                z.pullLo := low
                // The moment a support becomes a resistance it is a
                // NEW zone with a new name and now a new colour, so
                // its box starts HERE. It used to keep the left edge
                // of the level it replaced, which drew the band back
                // across a stretch of chart where it was acting as
                // the opposite kind of zone. The box ONLY -- bornBar
                // stays put, because snrz_core does not reset it on a
                // flip (only on a re-anchor) and the 3-touch counting
                // and the birth-bar guard both read it.
                box.set_left(z.bx, bar_index)
                line.set_xy1(z.mid, bar_index, (z.top + z.bot) / 2)
                if not na(z.bxRaw)
                    box.set_left(z.bxRaw, bar_index)
                z.touches := 0
                z.sigTouch := -1
                z.srr := false
                z.fba := false
                z.falseBreaks := 0
                z.flips := z.flips + 1
                z.dead := z.flips >= maxFlips
                z.pendBar := -1
                z.pendDir := 0
                zoneBreakDn := true
                array.push(brokeSupPx, z.bot)
        else if inZone and close >= z.bot and not z.dead
            if justEntered
                z.touches := z.touches + 1
                if z.state == 0 and z.touches >= 2
                    z.state := 1
                if (z.state != 2 and z.touches > maxTouches) or (z.state == 2 and z.touches > 2)
                    z.dead := true
    else
        if z.pendDir == 0 and bullBreak75(z.top)
            z.pendBar := bar_index
            z.pendDir := 1
        else if z.pendDir == 1
            if close <= z.top                     // came back: p47 False Breakout
                z.pendBar := -1
                z.pendDir := 0
                // 2026 master class, "FALSE BREAKOUT AREA": the area the
                // market has broken TWICE and then respected again. One
                // failed break is not an FBA — it takes two.
                z.falseBreaks := z.falseBreaks + 1
                z.fba  := z.falseBreaks >= 2
                z.dead := false
            else if bar_index - z.pendBar >= fbaBars
                z.wasValid := z.state == 1
                z.role  := 1
                z.state := 2
                z.awaitPull := flipNeedsPullback ? bar_index : -1
                z.pullHi := high
                z.pullLo := low
                // The moment a support becomes a resistance it is a
                // NEW zone with a new name and now a new colour, so
                // its box starts HERE. It used to keep the left edge
                // of the level it replaced, which drew the band back
                // across a stretch of chart where it was acting as
                // the opposite kind of zone. The box ONLY -- bornBar
                // stays put, because snrz_core does not reset it on a
                // flip (only on a re-anchor) and the 3-touch counting
                // and the birth-bar guard both read it.
                box.set_left(z.bx, bar_index)
                line.set_xy1(z.mid, bar_index, (z.top + z.bot) / 2)
                if not na(z.bxRaw)
                    box.set_left(z.bxRaw, bar_index)
                z.touches := 0
                z.sigTouch := -1
                z.srr := false
                z.fba := false
                z.falseBreaks := 0
                z.flips := z.flips + 1
                z.dead := z.flips >= maxFlips
                z.pendBar := -1
                z.pendDir := 0
                zoneBreakUp := true
                array.push(brokeResPx, z.top)
        else if inZone and close <= z.top and not z.dead
            if justEntered
                z.touches := z.touches + 1
                if z.state == 0 and z.touches >= 2
                    z.state := 1
                if (z.state != 2 and z.touches > maxTouches) or (z.state == 2 and z.touches > 2)
                    z.dead := true
    // ───────────────────────────── the entry ─────────────────────────────
    // This used to sit INSIDE the "else if inZone" branch on each side, so an
    // order could only be armed on a bar where price was already touching the
    // zone. But the entry is a LIMIT resting AT the zone: if price has to be
    // there for the order to exist, it then has to come back a SECOND time to
    // fill it, and every setup needed two visits instead of one. The book
    // puts the order on the zone and waits for the pullback — one visit. So
    // it is evaluated for every live zone on every bar, and being on the
    // correct SIDE of the zone is what qualifies it, not standing in it.
    //
    // This is the same shape as the Python engine's on_candle(), and the two
    // are meant to be read side by side.
    isBuy = z.role == 1
    // p24/p35: a paired zone was drawn FROM two touches, so the RETURN to it
    // is already the entry — it does not need a third.
    need = z.paired ? 1 : 2
    tradable = not z.dead and z.pendDir == 0 and z.awaitPull < 0 and ((z.state == 1 and z.touches >= need) or z.srr or (z.state == 2 and z.touches >= 1 and z.touches <= 2)) and (not entriesHtfOnly or z.htf) and (not requireNested or nested(z))
    okTrend  = (not useTrendFilter or (isBuy ? trendUp : trendDown) or trendUnknown or (allowCounterInv and z.state == 2)) and not (isBuy ? sweptHigh : sweptLow)
    // price must be on the side the trade comes FROM: above a support, below
    // a resistance — and near enough that the order would still be alive when
    // price arrives, rather than resting on a zone half a session away.
    gapToZone = isBuy ? close - z.top : z.bot - close
    sideOk = gapToZone > 0 and (armWithinAtr <= 0 or gapToZone <= atr * armWithinAtr)
    // ...and only ONCE per touch. Without this a zone re-armed the moment its
    // order expired and offered the same setup over and over while price sat
    // on the same side of it.
    if tradable and okTrend and canFire and sideOk and z.sigTouch != z.touches and not hasOrder(z.uid)
        // A limit rests ON the zone; a market order is filled where price is
        // NOW. The stop is the same price either way -- beyond the zone's far
        // edge -- so entering early pays for the gap twice: a wider stop and,
        // since the target has not moved, a shorter run to it. It still
        // measures better per trade, because a limit only fills when price
        // comes back and it often comes back because the zone is failing.
        entry = entryMarket ? close : (isBuy ? z.top : z.bot)
        // The stop belongs to the ZONE, not to wherever price happens to be.
        // This read a 3-bar swing, which was right while the order was armed
        // on the touch bar because those bars were then AT the zone. Armed
        // from a distance they can be anywhere, and one unrelated spike
        // dragged the stop past the ceiling and killed the setup. The zone's
        // own edge already IS the wick that drew it.
        rawSl = isBuy ? z.bot - atr * slBufferATR : z.top + atr * slBufferATR
        // too far from the zone and the stop is mostly empty air
        marketTooFar = entryMarket and marketWithin > 0 and gapToZone > atr * marketWithin
        risk  = math.max(math.abs(entry - rawSl), atr * minSlAtr)
        tooWide = maxSlAtr > 0 and risk > atr * maxSlAtr
        t1 = nextZone(isBuy, entry, 0)
        reward = isBuy ? t1 - entry : entry - t1
        if not na(t1) and not tooWide and not marketTooFar and reward >= risk * minRR and (maxRR <= 0 or reward <= risk * maxRR)
            t2 = nextZone(isBuy, entry, 1)
            t3 = nextZone(isBuy, entry, 2)
            // bank at a fixed multiple of risk instead of at the zone: the
            // zone test above still had to pass, so this changes only WHERE
            // the money comes off, not which setups are taken
            if fixedRExit
                fx = isBuy ? entry + risk * fixedRMult : entry - risk * fixedRMult
                t1 := fx
                t2 := fx
                t3 := fx
            isPO2 = z.state == 2 and z.touches == 1   // image 55: the fill IS the 2nd touch
            z.sigTouch := z.touches
            if isBuy
                po2Buy := isPO2 ? true : po2Buy
                buySig := isPO2 ? buySig : true
            else
                po2Sell := isPO2 ? true : po2Sell
                sellSig := isPO2 ? sellSig : true
            lastSigBar := bar_index
            // Every target is a zone that is ALREADY on the chart and still
            // unbroken. No second zone ahead means no TP2 — the whole
            // position comes off at TP1. The 2x/3x fallback that used to sit
            // here named a price the chart never did.
            array.push(orders, Ord.new(isBuy, isPO2, z.uid, bar_index, entry,
                 isBuy ? entry - risk : entry + risk, t1, na(t2) ? t1 : t2,
                 na(t3) ? (na(t2) ? t1 : t2) : t3,
                 zoneText(z), -9, false, chartMin >= 60, risk))
    refreshZone(z)

// SRR / RSS qualification (book): a Support whose move broke ≥2 Resistances
// becomes SRR (buy); a Resistance whose move broke ≥2 Supports becomes RSS.
nRes = distinctLevels(brokeResPx, atr)
nSup = distinctLevels(brokeSupPx, atr)
if nRes > 0 or nSup > 0
    for z in zones
        if z.state == 2 or z.dead
            continue
        if nRes > 0 and z.role == 1 and close > z.top
            z.oppBreaks := z.oppBreaks + nRes
            if z.oppBreaks >= 2
                z.srr := true
        if nSup > 0 and z.role == -1 and close < z.bot
            z.oppBreaks := z.oppBreaks + nSup
            if z.oppBreaks >= 2
                z.srr := true
        refreshZone(z)

// ───────────── Fill the resting orders, manage the live trades ─────────────
if array.size(orders) > 0
    for i = array.size(orders) - 1 to 0
        Ord o = array.get(orders, i)
        if o.stat == -9
            // a limit can only fill on a bar AFTER it was placed — filling it
            // on the same bar would be reading the future
            if bar_index > o.bar
                if low <= o.entry and high >= o.entry
                    o.stat := 0
                    o.bar  := bar_index
                else
                    blown = o.buy ? low <= o.sl : high >= o.sl
                    gone  = o.buy ? high >= o.tp1 : low <= o.tp1
                    if blown or gone or bar_index - o.bar > orderExpiry
                        array.remove(orders, i)
        else if o.stat == 0
            // on the FILL bar only the stop may be judged: a buy limit fills
            // because price traded DOWN to it, so a low beyond the stop came
            // after the fill, but the bar's high may have printed before it
            entryBar = bar_index == o.bar
            if o.buy
                if low <= o.sl
                    o.stat := o.be ? -2 : -1
                else if not entryBar
                    if high >= o.tp3
                        o.stat := 3
                    else if high >= o.tp2 and o.stat < 2
                        o.stat := 2
                    else if high >= o.tp1 and o.stat < 1
                        o.stat := 1
            else
                if high >= o.sl
                    o.stat := o.be ? -2 : -1
                else if not entryBar
                    if low <= o.tp3
                        o.stat := 3
                    else if low <= o.tp2 and o.stat < 2
                        o.stat := 2
                    else if low <= o.tp1 and o.stat < 1
                        o.stat := 1
            // image 41: the red 1:1 line is where the stop goes to entry and
            // money comes off — not the first zone target, which can be far
            if useBreakEven and not o.be and not entryBar
                r1 = o.buy ? o.entry + o.risk0 * beAtR : o.entry - o.risk0 * beAtR
                if (o.buy ? high >= r1 : low <= r1) or o.stat >= 1
                    o.sl := o.entry
                    o.be := true
            if o.stat == 3
                o.stat := 3
            if o.stat == 0 and bar_index - o.bar > maxTradeBars
                o.stat := -3                      // timed out, closed flat
            // a zone that stopped a trade out has proved it is not respected
            if killOnStop and o.stat == -1
                for z in zones
                    if z.uid == o.uid
                        z.dead := true
                        break

// keep the list from growing without bound
while array.size(orders) > 60
    array.shift(orders)

// ───────────── Draw every live order and trade ─────────────────────────────
var line[]  pl = array.new<line>()
var label[] pb = array.new<label>()

if barstate.islast
    for ln in pl
        line.delete(ln)
    array.clear(pl)
    for lb in pb
        label.delete(lb)
    array.clear(pb)

    if showPosition
        for o in orders
            if o.stat != -9 and o.stat != 0
                continue
            resting = o.stat == -9
            x1 = o.bar
            x2 = bar_index + 25
            dirCol  = o.buy ? colBuy : colSell
            headCol = color.new(o.po2 ? colGold : dirCol, resting ? 30 : 0)
            headTxt = color.new(o.po2 ? color.black : color.white, 0)
            kind    = o.swing ? "SWING" : "SCALP"
            dir     = o.buy ? "BUY" : "SELL"
            state   = resting ? " LIMIT · waiting" :
                      o.stat >= 1 ? "  ✓ TP" + str.tostring(o.stat) + (o.be ? " · risk free" : "") : "  • running"
            st      = resting ? line.style_dashed : line.style_solid

            array.push(pl, line.new(x1, o.entry, x2, o.entry, color = color.new(color.white, 25), width = 2, style = line.style_dotted))
            array.push(pl, line.new(x1, o.sl,    x2, o.sl,    color = color.new(colSell, resting ? 40 : 0), width = 2, style = st))
            array.push(pl, line.new(x1, o.tp1,   x2, o.tp1,   color = color.new(colBuy,  resting ? 40 : 0), width = 2, style = st))
            array.push(pl, line.new(x1, o.tp2,   x2, o.tp2,   color = color.new(colBuy, 45), width = 1, style = line.style_dashed))
            array.push(pl, line.new(x1, o.tp3,   x2, o.tp3,   color = color.new(colBuy, 65), width = 1, style = line.style_dashed))

            array.push(pb, label.new(x2, o.entry, dir + " · " + kind + (o.po2 ? " · PO2" : "") + " · " + o.zone + state + "\n" + str.tostring(o.entry, format.mintick), style = label.style_label_left, color = headCol, textcolor = headTxt, size = size.small))
            array.push(pb, label.new(x2, o.sl,  (o.be ? "SL·BE " : "SL   ") + str.tostring(o.sl, format.mintick), style = label.style_label_left, color = color.new(colSell, 15), textcolor = color.new(color.white, 0), size = size.tiny))
            array.push(pb, label.new(x2, o.tp1, "TP1  " + str.tostring(o.tp1, format.mintick), style = label.style_label_left, color = color.new(colBuy, 15), textcolor = color.new(color.white, 0), size = size.tiny))
            array.push(pb, label.new(x2, o.tp2, "TP2  " + str.tostring(o.tp2, format.mintick), style = label.style_label_left, color = color.new(colBuy, 45), textcolor = color.new(color.white, 20), size = size.tiny))
            array.push(pb, label.new(x2, o.tp3, "TP3  " + str.tostring(o.tp3, format.mintick), style = label.style_label_left, color = color.new(colBuy, 65), textcolor = color.new(color.white, 20), size = size.tiny))

// ───────────────────── History arrows ──────────────────────────────────────
plotshape(buySig,  "BUY",      shape.triangleup,   location.belowbar, color.new(#00c853, 0), size = size.tiny,  display = display.pane)
plotshape(sellSig, "SELL",     shape.triangledown, location.abovebar, color.new(#ff1744, 0), size = size.tiny,  display = display.pane)
plotshape(po2Buy,  "PO2 BUY",  shape.triangleup,   location.belowbar, color.new(#d4af37, 0), size = size.small, display = display.pane)
plotshape(po2Sell, "PO2 SELL", shape.triangledown, location.abovebar, color.new(#d4af37, 0), size = size.small, display = display.pane)

// ───────────────────── Zindan info panel ───────────────────────────────────
var table info = table.new(position.top_right, 1, 6, bgcolor = color.new(#0b0b0b, 8), frame_width = 2, frame_color = color.new(#d4af37, 20), border_width = 1, border_color = color.new(#d4af37, 75))
if showPanel and barstate.islast
    tSrc = (singleTf or trendState == 0) ? timeframe.period : htfTF
    trendTxt = inRange ? "◆ RANGE — no trade" : trendUp ? "▲ UPTREND " + tSrc : trendDown ? "▼ DOWNTREND " + tSrc : "◇ trend unclear"
    trendCol = inRange ? colGold : trendUp ? colBuy : trendDown ? colSell : colGold
    liveLtf = 0
    liveHtf = 0
    for z in zones
        if not z.dead
            if z.htf
                liveHtf += 1
            else
                liveLtf += 1
    nOrd = 0
    nRun = 0
    for o in orders
        if o.stat == -9
            nOrd += 1
        else if o.stat == 0
            nRun += 1
    posTxt = nOrd + nRun == 0 ? "— no setup right now —" :
             str.tostring(nOrd) + " limit waiting · " + str.tostring(nRun) + " running"
    table.cell(info, 0, 0, "⚜  SNRZ v19.2 —  ZiNDAN", text_color = colGold, text_size = size.normal)
    table.cell(info, 0, 1, "The Gold Chaser", text_color = color.new(colGold, 35), text_size = size.tiny)
    table.cell(info, 0, 2, trendTxt, text_color = trendCol, text_size = size.small)
    // With singleTf on there IS no analysis timeframe, so the second half of
    // this line always read "+ 0 @ 15" -- which looks exactly like an analysis
    // pass that is drawing nothing. Nothing is wrong; there is simply no second
    // pass to report. Say so instead of printing a zero.
    zonesTxt = singleTf ? "Zones: " + str.tostring(liveLtf) + " @ " + timeframe.period + "  (one timeframe)" : "Zones: " + str.tostring(liveLtf) + " @ " + timeframe.period + "  +  " + str.tostring(liveHtf) + " @ " + htfTF
    table.cell(info, 0, 3, zonesTxt, text_color = color.new(color.white, 20), text_size = size.small)
    table.cell(info, 0, 4, "Position: " + posTxt, text_color = color.new(color.white, 20), text_size = size.small)
    // "why is there no new signal?" — this row answers it directly
    ageTxt = lastSigBar < 0 ? "Last signal: none yet on this chart"
             : "Last signal: " + str.tostring(bar_index - lastSigBar) + " bars ago"
    ageCol = lastSigBar < 0 or bar_index - lastSigBar > 300 ? color.new(colGold, 20) : color.new(color.white, 20)
    table.cell(info, 0, 5, ageTxt, text_color = ageCol, text_size = size.small)

// ───────────────────────────── Alerts ──────────────────────────────────────
alertcondition(buySig or po2Buy,   "SNRZ Buy",        "SNRZ: BUY — V.S / SRR / I.VR / RBS zone rejection")
alertcondition(sellSig or po2Sell, "SNRZ Sell",       "SNRZ: SELL — V.R / RSS / I.VS / SBR zone rejection")
alertcondition(po2Buy,             "SNRZ PO2 Buy",    "SNRZ: Power of Second Touch — BUY")
alertcondition(po2Sell,            "SNRZ PO2 Sell",   "SNRZ: Power of Second Touch — SELL")
alertcondition(zoneBreakUp,        "SNRZ Break Up",   "SNRZ: Resistance broken (75%) → RBS/I.VR buy zone")
alertcondition(zoneBreakDn,        "SNRZ Break Down", "SNRZ: Support broken (75%) → SBR/I.VS sell zone")
