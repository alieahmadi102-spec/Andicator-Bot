//@version=6
// build: v5.1 — zones and trend come from the book's analysis timeframe
//               (5m chart → 15m zones, 15m → 1H, 30m → 4H, 1H → Daily,
//               4H → Weekly); the confirmation candle stays on the chart.
//               ONE trade at a time, and the last position keeps its
//               Entry/SL/TP1-3 on screen after it closes.
//               v5.1: a Weekly/Daily zone can be years old and thousands of
//               points away — TradingView scales the chart to fit every
//               drawing, so those ancient zones squashed the live candles into
//               a stripe. Zones further than 5 analysis-ATRs are dropped now.
//               SCALP/SWING is decided purely by the traded timeframe, so a
//               1m chart can no longer report a SWING trade.
// ═══════════════════════════════════════════════════════════════════════════
//  SNRZ Strategy Indicator — "Zindan The Gold Chaser" Masterclass (2026 book)
//
//  Entry types (book):  Buy:(V.S, I.VR, RBS, SRR)   Sell:(V.R, I.VS, SBR, RSS)
//  PO2 = 2nd retest of an INVERSION zone (strongest, gold).
//  Targets (book): TP1 = nearest opposite zone, TP2 = next zone,
//                  TP3 = far zone. Fallback 1R / 2R / 3R if no zone there.
//  SCALP vs SWING (book): M5/M15 = SCALP · H1/H4/Daily = SWING.
//  Nothing more, nothing less than the strategy in the book.
// ═══════════════════════════════════════════════════════════════════════════
indicator("SNRZ Strategy [Zindan] v5", "SNRZ v5.1", overlay = true, max_boxes_count = 200, max_labels_count = 200, max_lines_count = 200)

// ───────────────────────────── Inputs ──────────────────────────────────────
grpZ  = "Zones (SNRZ)"
zoneTF        = input.timeframe("", "Zone timeframe (empty = AUTO from the book's table)", group = grpZ, tooltip = "جدول رسمی کتاب: چارت 5m ⇒ زون 15m · 15m ⇒ 1H · 30m ⇒ 4H · 1H ⇒ Daily · 4H ⇒ Weekly. زون‌ها فقط در تایم بالا کشیده می‌شوند و تأیید روی خود چارت گرفته می‌شود.")
pivotLen      = input.int(10,   "Pivot length (swing sensitivity)",        minval = 2,  group = grpZ)
maxZones      = input.int(6,    "Max active zones",                        minval = 2,  maxval = 20, group = grpZ)
bigMoveMult   = input.float(1.5,"Big Movement ≥ ATR ×",                    minval = 0.1, step = 0.1, group = grpZ)
breakoutPct   = input.float(75, "Breakout rule (%)",                       minval = 50, maxval = 100, group = grpZ)
minZoneATR    = input.float(0.15,"Min zone height (ATR ×)",                minval = 0.05, step = 0.05, group = grpZ)
maxZoneATR    = input.float(1.2, "Max zone height (ATR ×)",                minval = 0.2,  step = 0.1,  group = grpZ)
zoneMaxAge    = input.int(400,  "Zone lifetime (analysis-TF bars)",        minval = 50, group = grpZ)
maxZoneDistATR= input.float(5.0, "Drop zones further than (analysis ATR ×)", minval = 1, step = 0.5, group = grpZ, tooltip = "زونی که خیلی دور از قیمت است نه قابل ترید است و نه باید مقیاس چارت را خراب کند. زون‌های دورتر از این فاصله حذف می‌شوند.")

grpS  = "Signals"
useTrendFilter = input.bool(true,  "Trade only with structure trend (Trend is King)", group = grpS)
allowCounterInv = input.bool(false, "Allow counter-trend entries on inversion zones", group = grpS, tooltip = "کتاب: «ترند پادشاه است». پیش‌فرض خاموش تا در روند صعودی سیگنال فروش ندهد.")
maxTouches     = input.int(3,      "Max touches on VALID zone (3-touch rule)", minval = 2, maxval = 4, group = grpS)
minSlAtr       = input.float(0.5,  "Minimum stop distance (analysis ATR ×)", minval = 0.1, step = 0.1, group = grpS, tooltip = "استاپ خیلی نزدیک با نویز عادی بازار سویپ می‌شود. حداقل فاصله بر مبنای ATR تایم تحلیل.")
needReject     = input.bool(true,  "Confirmation candle must close OUTSIDE the zone", group = grpS, tooltip = "کتاب: کندل تأیید باید زون را رد کند و بیرونش بسته شود، نه اینکه وسط زون بسته شود.")
rangeBars      = input.int(10,     "Range lockout (analysis-TF bars since opposite BOS)", minval = 2, group = grpS, tooltip = "کتاب: بازار Sideway خطرناک است. اگر هر دو طرف ساختار در این تعداد کندلِ تایم تحلیل شکسته شده باشد، بازار رنج است و ترید نمی‌کنیم.")
oneTrade       = input.bool(true,  "One trade at a time (no overtrade)",    group = grpS, tooltip = "کتاب: Overtrade نکن. تا وقتی پوزیشن باز است سیگنال جدید صادر نمی‌شود.")
tpMaxR         = input.float(6.0,  "Max R for TP1/TP2 (farther zone → TP3)", minval = 1, step = 0.5, group = grpS, tooltip = "کتاب: تارگت اول نزدیک‌ترین لیکوییدیتی است. زونی که خیلی دورتر است تارگت اول نیست و به TP3 منتقل می‌شود.")
maxTradeBars   = input.int(300,    "Close an open trade after N chart bars", minval = 20, group = grpS)
showPosition   = input.bool(true,  "Show active position (Entry/SL/TP1-3)", group = grpS)
showFresh      = input.bool(true,  "Show fresh (not yet valid) zones",     group = grpS)
showPanel      = input.bool(true,  "Show SNRZ info panel",                 group = grpS)

grpV  = "Style"
colSup   = input.color(color.new(#089981, 90), "Fresh Support",          group = grpV)
colRes   = input.color(color.new(#f23645, 90), "Fresh Resistance",       group = grpV)
colSupV  = input.color(color.new(#089981, 70), "VALID Support / SRR",    group = grpV)
colResV  = input.color(color.new(#f23645, 70), "VALID Resistance / RSS", group = grpV)
colInv   = input.color(color.new(#d4af37, 72), "Inversion zone (gold)",  group = grpV)
colBuy   = input.color(#00c853, "BUY color",  group = grpV)
colSell  = input.color(#ff1744, "SELL color", group = grpV)
colGold  = input.color(#d4af37, "Accent (Zindan gold)", group = grpV)

// ─────────────────────────── Core series ───────────────────────────────────
atr = ta.atr(14)

// Book timeframe table (Analysis → SKIP → Confirmation):
//   Weekly→Daily→4H · Daily→4H→1H · 4H→1H→30m · 1H→30m→15m · 15m→5m→5m
// Read right-to-left: the chart is the CONFIRMATION column, so 5m⇒15m,
// 15m⇒1H, 30m⇒4H, 1H⇒Daily, 4H⇒Weekly.
// The chart we watch IS the confirmation timeframe, so the analysis timeframe
// is read straight off that table. Zones must never be drawn on the chart
// timeframe itself — the book says zones live on W/D/4H/1H and the low
// timeframe is only for monitoring and confirmation.
chartMin = timeframe.in_seconds(timeframe.period) / 60
autoTF   = chartMin <= 5 ? "15" : chartMin <= 15 ? "60" : chartMin <= 30 ? "240" : chartMin <= 60 ? "D" : chartMin <= 1440 ? "W" : "M"
zoneTFx   = zoneTF == "" ? autoTF : zoneTF
zoneTfMin = timeframe.in_seconds(zoneTFx) / 60
tfRatio   = math.max(1.0, zoneTfMin / math.max(chartMin, 1.0))
// the pivot that created a zone sits pivotLen ANALYSIS bars back, which is this
// many CHART bars back — that is where the rectangle has to start
zoneBack  = math.min(100, int(math.round(pivotLen * tfRatio)))

// book: "put the SL beyond the shadow / on the liquidity", never inside the zone
swingLo3 = ta.lowest(low, 3)
swingHi3 = ta.highest(high, 3)

phSrc = ta.pivothigh(high, pivotLen, pivotLen)
plSrc = ta.pivotlow(low,  pivotLen, pivotLen)
bodyHiSrc = math.max(open[pivotLen], close[pivotLen])
bodyLoSrc = math.min(open[pivotLen], close[pivotLen])
// size of the movement made AFTER the pivot — the book's "Big Movement"
hiRunSrc = ta.highest(high, pivotLen)
loRunSrc = ta.lowest(low,  pivotLen)

[phZ, plZ, pBodyHiZ, pBodyLoZ, closeZ, atrZ, hiRunZ, loRunZ] = request.security(syminfo.tickerid, zoneTFx, [phSrc, plSrc, bodyHiSrc, bodyLoSrc, close[1], atr[1], hiRunSrc, loRunSrc], lookahead = barmerge.lookahead_off)

atrA    = na(atrZ) ? atr : atrZ           // ATR of the analysis timeframe
bigMove = atrA * bigMoveMult

newPH = not na(phZ) and (na(phZ[1]) or phZ != phZ[1])
newPL = not na(plZ) and (na(plZ[1]) or plZ != plZ[1])

// Trend is read on the ANALYSIS timeframe, never on the chart. "Trend is King"
// in the book means the Daily/H4 trend; measuring it on a 1m/5m chart made it
// flip every few candles, which is what let buys and sells alternate through
// the same range. Structure = the higher-timeframe swings; a break of one of
// them (BOS) is what turns the trend.
var float lastHigh = na
var float prevHigh = na
var float lastLow  = na
var float prevLow  = na
prevHigh := newPH ? lastHigh : prevHigh
lastHigh := newPH ? phZ : lastHigh
prevLow := newPL ? lastLow : prevLow
lastLow := newPL ? plZ : lastLow

var int trendState   = 0
var int lastBosUpBar = -99999
var int lastBosDnBar = -99999
bosUp = not na(lastHigh) and not na(closeZ) and closeZ > lastHigh + atrA * 0.1
bosDn = not na(lastLow)  and not na(closeZ) and closeZ < lastLow  - atrA * 0.1
// only the moment the structure breaks counts, not every bar it stays broken
bosUpNew = bosUp and not bosUp[1]
bosDnNew = bosDn and not bosDn[1]
if bosUpNew
    lastBosUpBar := bar_index
    trendState   := 1
if bosDnNew
    lastBosDnBar := bar_index
    trendState   := -1
if trendState == 0 and not na(prevHigh) and not na(prevLow)
    if lastHigh > prevHigh and lastLow > prevLow
        trendState := 1
    else if lastHigh < prevHigh and lastLow < prevLow
        trendState := -1
// both sides of structure broken recently = sideway. Book: "No Setup, No Trade".
rangeSpan = math.round(rangeBars * tfRatio)
inRange   = (bar_index - lastBosUpBar) <= rangeSpan and (bar_index - lastBosDnBar) <= rangeSpan
trendUp   = trendState == 1 and not inRange
trendDown = trendState == -1 and not inRange

// ─────────────────────────── Zone object ───────────────────────────────────
type Zone
    float top
    float bot
    int   role
    int   state
    int   touches
    int   sigTouch
    int   oppBreaks
    bool  srr
    bool  wasValid
    bool  dead
    int   bornBar
    box   bx
    line  mid

var zones = array.new<Zone>()

zoneColor(Zone z) =>
    z.state == 2 ? colInv : z.role == 1 ? (z.state == 1 or z.srr ? colSupV : colSup) : (z.state == 1 or z.srr ? colResV : colRes)

zoneText(Zone z) =>
    string base = na
    if z.role == 1
        base := z.state == 2 ? (z.wasValid ? "I.VR" : "RBS") : z.srr ? "SRR" : z.state == 1 ? "V.S" : "S"
    else
        base := z.state == 2 ? (z.wasValid ? "I.VS" : "SBR") : z.srr ? "RSS" : z.state == 1 ? "V.R" : "R"
    if z.dead
        base := base + " ✗"
    else if z.touches > 0
        base := base + " T" + str.tostring(z.touches)
    base

refreshZone(Zone z) =>
    hidden = z.state == 0 and not z.srr and not showFresh
    c = zoneColor(z)
    box.set_rightbottom(z.bx, bar_index + 8, z.bot)
    box.set_bgcolor(z.bx, hidden ? color.new(color.gray, 100) : c)
    box.set_border_color(z.bx, hidden ? color.new(color.gray, 100) : color.new(c, 25))
    box.set_border_style(z.bx, z.state == 0 and not z.srr ? line.style_dashed : line.style_solid)
    box.set_text(z.bx, hidden ? "" : zoneText(z))
    box.set_text_color(z.bx, hidden ? color.new(color.gray, 100) : color.new(c, 0))
    box.set_text_size(z.bx, size.small)
    box.set_text_halign(z.bx, text.align_right)
    line.set_xy1(z.mid, z.bornBar - zoneBack, (z.top + z.bot) / 2)
    line.set_xy2(z.mid, bar_index + 8, (z.top + z.bot) / 2)
    line.set_color(z.mid, hidden ? color.new(color.gray, 100) : color.new(c, 45))

newZone(float _top, float _bot, int _role) =>
    h  = _top - _bot
    mn = atrA * minZoneATR
    mx = atrA * maxZoneATR
    t  = _top
    b  = _bot
    if h < mn
        mid = (t + b) / 2
        t := mid + mn / 2
        b := mid - mn / 2
    if t - b > mx
        if _role == 1
            t := b + mx
        else
            b := t - mx
    bx = box.new(bar_index - zoneBack, t, bar_index + 8, b, border_color = color.new(color.gray, 60), bgcolor = colSup)
    md = line.new(bar_index - zoneBack, (t + b) / 2, bar_index + 8, (t + b) / 2, style = line.style_dashed, color = color.new(color.gray, 50))
    Zone.new(t, b, _role, 0, 0, 0, 0, false, false, false, bar_index, bx, md)

overlaps(float _top, float _bot) =>
    res = false
    for z in zones
        if not (_bot > z.top or _top < z.bot)
            res := true
            break
    res

killZone(int idx) =>
    Zone z = array.get(zones, idx)
    box.delete(z.bx)
    line.delete(z.mid)
    array.remove(zones, idx)

// ─────────────── Cleanup ────────────────────────────────────────────────────
// lifetime counted in ANALYSIS-timeframe bars, so a 1H zone is not thrown away
// after a couple of hours just because the chart is on 1m
zoneLife = zoneMaxAge * tfRatio
// A Weekly/Daily zone can be years old and hundreds of points away from price.
// It is not tradeable any more, and worse: TradingView scales the chart to fit
// every drawing, so one ancient zone squashes the live candles into a stripe.
// Anything further than this many analysis-ATRs from price is dropped.
maxZoneDist = atrA * maxZoneDistATR
if array.size(zones) > 0
    for i = array.size(zones) - 1 to 0
        Zone z = array.get(zones, i)
        gap = close > z.top ? close - z.top : close < z.bot ? z.bot - close : 0.0
        if bar_index - z.bornBar > zoneLife or (not na(atrA) and gap > maxZoneDist)
            killZone(i)
while array.size(zones) > maxZones
    killZone(0)

// ─────────────── Create zones from confirmed HTF pivots ────────────────────
// book: the zone is only born if the price left it with a BIG MOVEMENT, and
// the movement is measured on the analysis timeframe, not on the chart.
if newPL and not na(atrZ)
    pTop = pBodyLoZ
    pBot = plZ
    if (hiRunZ - pBot) >= bigMove and not overlaps(pTop, pBot)
        array.push(zones, newZone(pTop, pBot, 1))

if newPH and not na(atrZ)
    pTop = phZ
    pBot = pBodyHiZ
    if (pTop - loRunZ) >= bigMove and not overlaps(pTop, pBot)
        array.push(zones, newZone(pTop, pBot, -1))

// ───────────────── Confirmation candles ────────────────────────────────────
bullEngulf = close > open and close[1] < open[1] and close >= open[1]
bearEngulf = close < open and close[1] > open[1] and close <= open[1]
range_  = high - low
bullPin = range_ > 0 and (math.min(open, close) - low) >= 0.6 * range_ and close >= open
bearPin = range_ > 0 and (high - math.max(open, close)) >= 0.6 * range_ and close <= open
bullConfirm = bullEngulf or bullPin
bearConfirm = bearEngulf or bearPin

// ───────────── 75% breakout rule ────────────────────────────────────────────
bullBreak75(float lvl) =>
    fullBody = close > lvl and open > lvl
    partial = false
    if close > lvl and not fullBody
        bodyLow = math.min(open, close)
        len = high - bodyLow
        partial := len > 0 and (high - math.max(lvl, bodyLow)) / len * 100 >= breakoutPct
    fullBody or partial

bearBreak75(float lvl) =>
    fullBody = close < lvl and open < lvl
    partial = false
    if close < lvl and not fullBody
        bodyHigh = math.max(open, close)
        len = bodyHigh - low
        partial := len > 0 and (math.min(lvl, bodyHigh) - low) / len * 100 >= breakoutPct
    fullBody or partial

// ───────────── Active position state (declared before the engine so a new
//               signal can be blocked while a trade is still running) ────────
var bool   posOn    = false
var bool   posBuy   = false
var bool   posPO2   = false
var float  posEntry = na
var float  posSL    = na
var float  posTP1   = na
var float  posTP2   = na
var float  posTP3   = na
var bool   posSwing = false
var int    posBar   = 0
var string posZone  = ""
var int    posStat  = 0     // 0 running · 1/2/3 TP hit · -1 stopped out

// ─────────────────────── Zone engine ───────────────────────────────────────
bool buySig      = false
bool sellSig     = false
bool po2Buy      = false
bool po2Sell     = false
bool zoneBreakUp = false
bool zoneBreakDn = false
bool brokeResistanceNow = false
bool brokeSupportNow    = false

// signal captured this bar (drawn after the loop)
bool  sigFired = false
bool  sigIsBuy = false
bool  sigIsPO2 = false
float sigSl    = na
string sigZone = ""
// book: don't overtrade — manage one setup at a time
canFire = not (oneTrade and posOn)

for z in zones
    if bar_index <= z.bornBar
        refreshZone(z)
        continue
    inZone      = low <= z.top and high >= z.bot
    justEntered = inZone and not (low[1] <= z.top and high[1] >= z.bot)

    if z.role == 1
        if bearBreak75(z.bot)
            z.wasValid := z.state == 1
            z.role  := -1
            z.state := 2
            z.touches := 0
            z.sigTouch := 0
            z.srr := false
            z.dead := false
            zoneBreakDn := true
            brokeSupportNow := true
        else if inZone and close >= z.bot and not z.dead
            if justEntered
                z.touches := z.touches + 1
                if z.state == 0 and z.touches >= 2
                    z.state := 1
                if (z.state != 2 and z.touches > maxTouches) or (z.state == 2 and z.touches > 2)
                    z.dead := true
            tradable = not z.dead and ((z.state == 1 and z.touches >= 2) or (z.srr and z.touches >= 1) or (z.state == 2 and z.touches >= 1 and z.touches <= 2))
            okTrend  = not useTrendFilter or trendUp or (allowCounterInv and z.state == 2)
            freshSig = z.sigTouch != z.touches
            rejectOK = needReject ? close > z.top : close > z.bot
            if tradable and okTrend and freshSig and bullConfirm and rejectOK and canFire and not sigFired
                z.sigTouch := z.touches
                isPO2 = z.state == 2 and z.touches == 2
                po2Buy := isPO2 ? true : po2Buy
                buySig := isPO2 ? buySig : true
                sigFired := true
                sigIsBuy := true
                sigIsPO2 := isPO2
                sigSl := math.min(z.bot, swingLo3) - atrA * 0.15
                sigZone := zoneText(z)
    else
        if bullBreak75(z.top)
            z.wasValid := z.state == 1
            z.role  := 1
            z.state := 2
            z.touches := 0
            z.sigTouch := 0
            z.srr := false
            z.dead := false
            zoneBreakUp := true
            brokeResistanceNow := true
        else if inZone and close <= z.top and not z.dead
            if justEntered
                z.touches := z.touches + 1
                if z.state == 0 and z.touches >= 2
                    z.state := 1
                if (z.state != 2 and z.touches > maxTouches) or (z.state == 2 and z.touches > 2)
                    z.dead := true
            tradable = not z.dead and ((z.state == 1 and z.touches >= 2) or (z.srr and z.touches >= 1) or (z.state == 2 and z.touches >= 1 and z.touches <= 2))
            okTrend  = not useTrendFilter or trendDown or (allowCounterInv and z.state == 2)
            freshSig = z.sigTouch != z.touches
            rejectOK = needReject ? close < z.bot : close < z.top
            if tradable and okTrend and freshSig and bearConfirm and rejectOK and canFire and not sigFired
                z.sigTouch := z.touches
                isPO2 = z.state == 2 and z.touches == 2
                po2Sell := isPO2 ? true : po2Sell
                sellSig := isPO2 ? sellSig : true
                sigFired := true
                sigIsBuy := false
                sigIsPO2 := isPO2
                sigSl := math.max(z.top, swingHi3) + atrA * 0.15
                sigZone := zoneText(z)
    refreshZone(z)

// SRR / RSS qualification (book)
if brokeResistanceNow or brokeSupportNow
    for z in zones
        if z.state == 2 or z.dead
            continue
        if brokeResistanceNow and z.role == 1 and z.touches == 0 and close > z.top
            z.oppBreaks := z.oppBreaks + 1
            if z.oppBreaks >= 2
                z.srr := true
        if brokeSupportNow and z.role == -1 and z.touches == 0 and close < z.bot
            z.oppBreaks := z.oppBreaks + 1
            if z.oppBreaks >= 2
                z.srr := true
        refreshZone(z)

// ───────────── Open the position on a NEW signal ───────────────────────────
if sigFired
    entry = close
    rawRisk = math.abs(entry - sigSl)
    risk  = math.max(rawRisk, atrA * minSlAtr)
    slLvl = sigIsBuy ? entry - risk : entry + risk
    // targets = opposite zones ahead of price (book), else 1R / 2R / 3R
    // collect the DISTANCE of every opposite zone lying ahead of price, so the
    // three targets always come out ordered nearest → farthest whether they
    // come from zones or from the 1R/2R/3R fallback.
    dists = array.new<float>()
    for z in zones
        if z.dead
            continue
        lvl = sigIsBuy ? z.bot : z.top
        ahead = sigIsBuy ? (z.role == -1 and lvl > entry) : (z.role == 1 and lvl < entry)
        if ahead
            array.push(dists, math.abs(lvl - entry))
    if array.size(dists) > 1
        array.sort(dists, order.ascending)
    // The book takes TP1 at the NEAREST liquidity. A zone sitting 15R away is
    // a destination, not a first target — only zones within tpMaxR feed
    // TP1/TP2; anything beyond that can still serve as TP3.
    cap  = risk * tpMaxR
    near = array.new<float>()
    far  = array.new<float>()
    for d in dists
        if d <= cap
            array.push(near, d)
        else
            array.push(far, d)
    n  = array.size(near)
    nf = array.size(far)
    float d1 = n >= 1 ? array.get(near, 0) : risk
    float d2 = n >= 2 ? array.get(near, 1) : math.max(d1 + risk, risk * 2)
    float d3 = n >= 3 ? array.get(near, 2) : (nf > 0 ? array.get(far, 0) : math.max(d2 + risk, risk * 3))
    // book: RR at least 1:1, and each target must sit beyond the previous one
    d1 := math.max(d1, risk)
    d2 := math.max(d2, d1 + risk * 0.5)
    d3 := math.max(d3, d2 + risk * 0.5)
    t1 = sigIsBuy ? entry + d1 : entry - d1
    t2 = sigIsBuy ? entry + d2 : entry - d2
    t3 = sigIsBuy ? entry + d3 : entry - d3
    posOn    := true
    posBuy   := sigIsBuy
    posPO2   := sigIsPO2
    posEntry := entry
    posSL    := slLvl
    posTP1   := t1
    posTP2   := t2
    posTP3   := t3
    // book: "Scalper works M5/M15 · Swing works H1/H4/Daily" — it is the
    // timeframe you TRADE on that decides this, nothing else. A 1m chart is
    // never a swing trade, however far the target happens to sit.
    posSwing := chartMin >= 60
    posBar   := bar_index
    posZone  := sigZone
    posStat  := 0

// track how the open position actually resolved (helps judge signal quality)
else if posOn and posStat >= 0
    if posBuy
        if low <= posSL
            posStat := -1
            posOn := false
        else if high >= posTP3
            posStat := 3
            posOn := false
        else if high >= posTP2 and posStat < 2
            posStat := 2
        else if high >= posTP1 and posStat < 1
            posStat := 1
    else
        if high >= posSL
            posStat := -1
            posOn := false
        else if low <= posTP3
            posStat := 3
            posOn := false
        else if low <= posTP2 and posStat < 2
            posStat := 2
        else if low <= posTP1 and posStat < 1
            posStat := 1
    // a setup that never resolved must not block the next one forever
    if posOn and bar_index - posBar > maxTradeBars
        posOn := false

// ───────────── Draw the single active position (clean) ─────────────────────
var line[]  pl = array.new<line>()
var label[] pb = array.new<label>()

if barstate.islast
    for ln in pl
        line.delete(ln)
    array.clear(pl)
    for lb in pb
        label.delete(lb)
    array.clear(pb)

// the LAST setup stays on the chart even after it closed, so the levels are
// always visible — a closed one is just drawn faded and tagged with its result
if showPosition and not na(posEntry) and barstate.islast

    x1 = posBar
    x2 = bar_index + 25
    fade    = posOn ? 0 : 55
    dirCol  = posBuy ? colBuy : colSell
    headCol = color.new(posPO2 ? colGold : dirCol, fade)
    headTxt = color.new(posPO2 ? color.black : color.white, posOn ? 0 : 30)
    kind    = posSwing ? "SWING" : "SCALP"
    dir     = posBuy ? "BUY" : "SELL"
    stStyle = posOn ? line.style_solid : line.style_dotted

    array.push(pl, line.new(x1, posEntry, x2, posEntry, color = color.new(color.white, 25 + fade / 2), width = 2, style = line.style_dotted))
    array.push(pl, line.new(x1, posSL,    x2, posSL,    color = color.new(colSell, fade), width = 2, style = stStyle))
    array.push(pl, line.new(x1, posTP1,   x2, posTP1,   color = color.new(colBuy, fade),  width = 2, style = stStyle))
    array.push(pl, line.new(x1, posTP2,   x2, posTP2,   color = color.new(colBuy, 35 + fade / 2), width = 1, style = line.style_dashed))
    array.push(pl, line.new(x1, posTP3,   x2, posTP3,   color = color.new(colBuy, 55 + fade / 2), width = 1, style = line.style_dashed))

    statTxt = posStat == -1 ? "  ✗ SL" : posStat == 3 ? "  ✓ TP3" : posStat == 2 ? "  ✓ TP2" : posStat == 1 ? "  ✓ TP1" : posOn ? "  • running" : "  • closed"
    array.push(pb, label.new(x2, posEntry, dir + " · " + kind + (posPO2 ? " · PO2" : "") + " · " + posZone + statTxt + "\n" + str.tostring(posEntry, format.mintick), style = label.style_label_left, color = headCol, textcolor = headTxt, size = size.normal))
    array.push(pb, label.new(x2, posSL,  "SL   " + str.tostring(posSL,  format.mintick), style = label.style_label_left, color = color.new(colSell, 10 + fade / 2), textcolor = color.new(color.white, fade / 2), size = size.small))
    array.push(pb, label.new(x2, posTP1, "TP1  " + str.tostring(posTP1, format.mintick), style = label.style_label_left, color = color.new(colBuy, 10 + fade / 2), textcolor = color.new(color.white, fade / 2), size = size.small))
    array.push(pb, label.new(x2, posTP2, "TP2  " + str.tostring(posTP2, format.mintick), style = label.style_label_left, color = color.new(colBuy, 35 + fade / 2), textcolor = color.new(color.white, fade / 2), size = size.small))
    array.push(pb, label.new(x2, posTP3, "TP3  " + str.tostring(posTP3, format.mintick), style = label.style_label_left, color = color.new(colBuy, 55 + fade / 2), textcolor = color.new(color.white, fade / 2), size = size.small))

// ───────────────────── Small history arrows ────────────────────────────────
plotshape(buySig,  "BUY",      shape.triangleup,   location.belowbar, color.new(#00c853, 0), size = size.tiny,  display = display.pane)
plotshape(sellSig, "SELL",     shape.triangledown, location.abovebar, color.new(#ff1744, 0), size = size.tiny,  display = display.pane)
plotshape(po2Buy,  "PO2 BUY",  shape.triangleup,   location.belowbar, color.new(#d4af37, 0), size = size.small, display = display.pane)
plotshape(po2Sell, "PO2 SELL", shape.triangledown, location.abovebar, color.new(#d4af37, 0), size = size.small, display = display.pane)

// ───────────────────── Zindan info panel ───────────────────────────────────
var table info = table.new(position.top_right, 1, 5, bgcolor = color.new(#0b0b0b, 8), frame_width = 2, frame_color = color.new(#d4af37, 20), border_width = 1, border_color = color.new(#d4af37, 75))
if showPanel and barstate.islast
    trendTxt = inRange ? "◆ RANGE — no trade" : trendUp ? "▲ UPTREND " + zoneTFx : trendDown ? "▼ DOWNTREND " + zoneTFx : "◆ RANGE"
    trendCol = inRange ? colGold : trendUp ? colBuy : trendDown ? colSell : colGold
    activeCnt = 0
    for z in zones
        if not z.dead
            activeCnt += 1
    stTxt = posStat == -1 ? " ✗SL" : posStat > 0 ? " ✓TP" + str.tostring(posStat) : " •"
    posTxt = not na(posEntry) ? ((posBuy ? "BUY " : "SELL ") + (posSwing ? "SWING" : "SCALP") + " @ " + str.tostring(posEntry, format.mintick) + stTxt + (posOn ? "" : " (closed)")) : "—"
    table.cell(info, 0, 0, "⚜  SNRZ v5.1  —  ZiNDAN", text_color = colGold, text_size = size.normal)
    table.cell(info, 0, 1, "The Gold Chaser", text_color = color.new(colGold, 35), text_size = size.tiny)
    table.cell(info, 0, 2, trendTxt, text_color = trendCol, text_size = size.small)
    table.cell(info, 0, 3, "Zones: " + str.tostring(activeCnt) + " @ " + zoneTFx + "   ⇢ confirm " + timeframe.period, text_color = color.new(color.white, 20), text_size = size.small)
    table.cell(info, 0, 4, "Position: " + posTxt, text_color = color.new(color.white, 20), text_size = size.small)

// ───────────────────────────── Alerts ──────────────────────────────────────
alertcondition(buySig or po2Buy,   "SNRZ Buy",        "SNRZ: BUY — V.S / SRR / I.VR / RBS zone rejection")
alertcondition(sellSig or po2Sell, "SNRZ Sell",       "SNRZ: SELL — V.R / RSS / I.VS / SBR zone rejection")
alertcondition(po2Buy,             "SNRZ PO2 Buy",    "SNRZ: Power of Second Touch — BUY")
alertcondition(po2Sell,            "SNRZ PO2 Sell",   "SNRZ: Power of Second Touch — SELL")
alertcondition(zoneBreakUp,        "SNRZ Break Up",   "SNRZ: Resistance broken (75%) → RBS/I.VR buy zone")
alertcondition(zoneBreakDn,        "SNRZ Break Down", "SNRZ: Support broken (75%) → SBR/I.VS sell zone")
