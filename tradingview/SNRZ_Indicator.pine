//@version=6
// build: v3.0 — full book compliance: SRR/RSS zones, HTF zone timeframe (book workflow),
//               PO2 only on inversion 2nd touch, book naming (I.VS / I.VR / SBR / RBS / SRR / RSS)
// ═══════════════════════════════════════════════════════════════════════════
//  SNRZ Strategy Indicator — "Zindan The Gold Chaser" Masterclass (2026 book)
//
//  Official confirmation types (book):   Buy:(V.S, I.VR, RBS, SRR)
//                                        Sell:(V.R, I.VS, SBR, RSS)
//  Rules implemented:
//   • Zones drawn on the HTF (book: Weekly/Daily/4H/1H) via "Zone timeframe"
//     input; signals & confirmation happen on the chart TF (book: 15m/5m).
//   • Valid S/R = First Big Movement + Second Big Movement (2nd touch).
//   • 75% breakout rule (body + directional shadow only) → Inversion:
//     broken zone keeps its ORIGIN name (V.S→I.VS sell, V.R→I.VR buy,
//     S→SBR sell, R→RBS buy) and is traded on the pullback.
//   • PO2 (Power of Second Touch) = 2nd retest of an INVERSION zone only.
//   • SRR: a Support whose move broke ≥2 Resistances → BUY on pullback.
//     RSS: a Resistance whose move broke ≥2 Supports → SELL on pullback.
//   • 3-touch rule: zone exhausted after 3rd touch (2nd retest on inversion).
//   • One signal per touch. Confirmation candle (SNRZ engulf / pin bar).
//   • Structure trend filter (book power ranking #1: Trend).
//  Best market per the course: XAUUSD.
// ═══════════════════════════════════════════════════════════════════════════
indicator("SNRZ Strategy [Zindan]", "SNRZ", overlay = true, max_boxes_count = 250, max_labels_count = 250)

// ───────────────────────────── Inputs ──────────────────────────────────────
grpZ  = "Zones (SNRZ)"
zoneTF        = input.timeframe("", "Zone timeframe (book: 1H/4H — empty = chart TF)", group = grpZ, tooltip = "کتاب: زون در Weekly/Daily/4H/1H مشخص می‌شود و تأیید در تایم پایین‌تر (15m/5m). مثلا چارت را 5m بگذار و اینجا 1H را انتخاب کن")
pivotLen      = input.int(10,   "Pivot length (swing sensitivity)",        minval = 2,  group = grpZ)
maxZones      = input.int(6,    "Max active zones",                        minval = 2,  maxval = 20, group = grpZ)
bigMoveMult   = input.float(1.5,"Big Movement ≥ ATR ×",                    minval = 0.1, step = 0.1, group = grpZ)
breakoutPct   = input.float(75, "Breakout rule (%)",                       minval = 50, maxval = 100, group = grpZ)
minZoneATR    = input.float(0.15,"Min zone height (ATR ×)",                minval = 0.05, step = 0.05, group = grpZ)
maxZoneATR    = input.float(1.2, "Max zone height (ATR ×)",                minval = 0.2,  step = 0.1,  group = grpZ)
zoneMaxAge    = input.int(400,  "Zone lifetime (chart bars)",              minval = 50, group = grpZ)

grpS  = "Signals"
useTrendFilter = input.bool(true,  "Trade only with structure trend (Trend is King)", group = grpS)
maxTouches     = input.int(3,      "Max touches on VALID zone (3-touch rule)", minval = 2, maxval = 4, group = grpS)
showSweeps     = input.bool(false, "Show liquidity Sweep markers",         group = grpS)
showFresh      = input.bool(true,  "Show fresh (not yet valid) zones",     group = grpS)

grpV  = "Style"
colSup   = input.color(color.new(#089981, 88), "Fresh Support",       group = grpV)
colRes   = input.color(color.new(#f23645, 88), "Fresh Resistance",    group = grpV)
colSupV  = input.color(color.new(#089981, 60), "VALID Support / SRR", group = grpV)
colResV  = input.color(color.new(#f23645, 60), "VALID Resistance / RSS", group = grpV)
colInv   = input.color(color.new(#ff9800, 65), "Inversion zone",      group = grpV)
showLbl  = input.bool(true, "Zone labels", group = grpV)

// ─────────────────────────── Core series ───────────────────────────────────
atr = ta.atr(14)
bigMove = atr * bigMoveMult

// Zone-timeframe pivots (book workflow: zones on HTF, entries on chart TF)
phSrc = ta.pivothigh(high, pivotLen, pivotLen)
plSrc = ta.pivotlow(low,  pivotLen, pivotLen)
bodyHiSrc = math.max(open[pivotLen], close[pivotLen])
bodyLoSrc = math.min(open[pivotLen], close[pivotLen])

[phZ, plZ, pBodyHiZ, pBodyLoZ] = request.security(syminfo.tickerid, zoneTF, [phSrc, plSrc, bodyHiSrc, bodyLoSrc], lookahead = barmerge.lookahead_off)

// fire zone creation only once per new HTF pivot value
newPH = not na(phZ) and (na(phZ[1]) or phZ != phZ[1])
newPL = not na(plZ) and (na(plZ[1]) or plZ != plZ[1])

// Market structure trend (chart TF)
var float lastHigh = na
var float prevHigh = na
var float lastLow  = na
var float prevLow  = na
if not na(phSrc)
    prevHigh := lastHigh
    lastHigh := phSrc
if not na(plSrc)
    prevLow := lastLow
    lastLow := plSrc
trendUp   = not na(prevHigh) and not na(prevLow) and lastHigh > prevHigh and lastLow > prevLow
trendDown = not na(prevHigh) and not na(prevLow) and lastHigh < prevHigh and lastLow < prevLow

// ─────────────────────────── Zone object ───────────────────────────────────
// role : 1 Support (buy) / -1 Resistance (sell)
// state: 0 fresh, 1 VALID, 2 inversion
type Zone
    float top
    float bot
    int   role
    int   state
    int   touches
    int   sigTouch     // anti-spam latch: one signal per touch
    int   oppBreaks    // opposite zones broken since creation (SRR/RSS rule)
    bool  srr          // qualified as SRR (support) / RSS (resistance)
    bool  wasValid
    bool  dead
    int   bornBar
    box   bx
    label lb

var zones = array.new<Zone>()

zoneColor(Zone z) =>
    z.state == 2 ? colInv : z.role == 1 ? (z.state == 1 or z.srr ? colSupV : colSup) : (z.state == 1 or z.srr ? colResV : colRes)

// Book naming: broken zone keeps its ORIGIN name.
zoneText(Zone z) =>
    string base = na
    if z.role == 1
        base := z.state == 2 ? (z.wasValid ? "I.VR" : "RBS") : z.srr ? "SRR" : z.state == 1 ? "V.S" : "S"
    else
        base := z.state == 2 ? (z.wasValid ? "I.VS" : "SBR") : z.srr ? "RSS" : z.state == 1 ? "V.R" : "R"
    if z.dead
        base := base + " ✗"
    else if z.touches > 0
        base := base + " T" + str.tostring(z.touches)
    base

refreshZone(Zone z) =>
    hidden = z.state == 0 and not z.srr and not showFresh
    c = hidden ? color.new(color.gray, 100) : zoneColor(z)
    box.set_rightbottom(z.bx, bar_index + 6, z.bot)
    box.set_bgcolor(z.bx, c)
    box.set_border_color(z.bx, hidden ? color.new(color.gray, 100) : color.new(c, 30))
    if showLbl
        label.set_xy(z.lb, bar_index + 6, (z.top + z.bot) / 2)
        label.set_text(z.lb, hidden ? "" : zoneText(z))
        label.set_textcolor(z.lb, color.new(zoneColor(z), 0))

newZone(float _top, float _bot, int _role) =>
    h  = _top - _bot
    mn = atr * minZoneATR
    mx = atr * maxZoneATR
    t  = _top
    b  = _bot
    if h < mn
        mid = (t + b) / 2
        t := mid + mn / 2
        b := mid - mn / 2
    if t - b > mx
        if _role == 1
            t := b + mx
        else
            b := t - mx
    bx = box.new(bar_index - pivotLen, t, bar_index + 6, b, border_color = color.new(color.gray, 60), bgcolor = colSup)
    lb = showLbl ? label.new(bar_index + 6, (t + b) / 2, "", style = label.style_label_left, textcolor = color.white, color = color.new(color.black, 100), size = size.small) : label(na)
    Zone.new(t, b, _role, 0, 0, 0, 0, false, false, false, bar_index, bx, lb)

overlaps(float _top, float _bot) =>
    res = false
    for z in zones
        if not (_bot > z.top or _top < z.bot)
            res := true
            break
    res

killZone(int idx) =>
    Zone z = array.get(zones, idx)
    box.delete(z.bx)
    label.delete(z.lb)
    array.remove(zones, idx)

// ─────────────── Cleanup: age limit + max count ─────────────────────────────
if array.size(zones) > 0
    for i = array.size(zones) - 1 to 0
        Zone z = array.get(zones, i)
        if bar_index - z.bornBar > zoneMaxAge
            killZone(i)
while array.size(zones) > maxZones
    killZone(0)

// ─────────────── Create zones from confirmed HTF pivots ────────────────────
if newPL
    pTop = pBodyLoZ
    pBot = plZ
    if (high - pBot) >= bigMove and not overlaps(pTop, pBot)
        array.push(zones, newZone(pTop, pBot, 1))

if newPH
    pTop = phZ
    pBot = pBodyHiZ
    if (pTop - low) >= bigMove and not overlaps(pTop, pBot)
        array.push(zones, newZone(pTop, pBot, -1))

// ───────────────── Confirmation candles (SNRZ style) ───────────────────────
bullEngulf = close > open and close[1] < open[1] and close >= open[1]
bearEngulf = close < open and close[1] > open[1] and close <= open[1]
range_  = high - low
bullPin = range_ > 0 and (math.min(open, close) - low) >= 0.6 * range_ and close >= open
bearPin = range_ > 0 and (high - math.max(open, close)) >= 0.6 * range_ and close <= open
bullConfirm = bullEngulf or bullPin
bearConfirm = bearEngulf or bearPin

// ───────────── 75% breakout rule (body + directional shadow) ───────────────
bullBreak75(float lvl) =>
    fullBody = close > lvl and open > lvl
    partial = false
    if close > lvl and not fullBody
        bodyLow = math.min(open, close)
        len = high - bodyLow
        partial := len > 0 and (high - math.max(lvl, bodyLow)) / len * 100 >= breakoutPct
    fullBody or partial

bearBreak75(float lvl) =>
    fullBody = close < lvl and open < lvl
    partial = false
    if close < lvl and not fullBody
        bodyHigh = math.max(open, close)
        len = bodyHigh - low
        partial := len > 0 and (math.min(lvl, bodyHigh) - low) / len * 100 >= breakoutPct
    fullBody or partial

// ─────────────────────── Zone engine ───────────────────────────────────────
bool buySig      = false
bool sellSig     = false
bool po2Buy      = false
bool po2Sell     = false
bool zoneBreakUp = false
bool zoneBreakDn = false

// pass 1: detect breaks (also feeds the SRR/RSS counters)
bool brokeResistanceNow = false
bool brokeSupportNow    = false

for z in zones
    if bar_index <= z.bornBar
        refreshZone(z)
        continue
    inZone      = low <= z.top and high >= z.bot
    justEntered = inZone and not (low[1] <= z.top and high[1] >= z.bot)

    if z.role == 1
        // ─── SUPPORT / SRR / inversion-buy zone ───
        if bearBreak75(z.bot)
            z.wasValid := z.state == 1
            z.role  := -1
            z.state := 2
            z.touches := 0
            z.sigTouch := 0
            z.srr := false
            z.dead := false
            zoneBreakDn := true
            brokeSupportNow := true
        else if inZone and close >= z.bot and not z.dead
            if justEntered
                z.touches := z.touches + 1
                if z.state == 0 and z.touches >= 2
                    z.state := 1                      // Second Movement → VALID
                if (z.state != 2 and z.touches > maxTouches) or (z.state == 2 and z.touches > 2)
                    z.dead := true                    // 3-touch rule
            // tradable: VALID touch≥2  |  SRR touch≥1  |  INVERSION touch 1-2
            tradable = not z.dead and ((z.state == 1 and z.touches >= 2) or (z.srr and z.touches >= 1) or (z.state == 2 and z.touches >= 1 and z.touches <= 2))
            okTrend  = not useTrendFilter or trendUp or z.state == 2
            fresh    = z.sigTouch != z.touches
            if tradable and okTrend and fresh and bullConfirm and close > z.bot
                z.sigTouch := z.touches
                if z.state == 2 and z.touches == 2
                    po2Buy := true                    // PO2: inversion 2nd touch only
                else
                    buySig := true
    else
        // ─── RESISTANCE / RSS / inversion-sell zone ───
        if bullBreak75(z.top)
            z.wasValid := z.state == 1
            z.role  := 1
            z.state := 2
            z.touches := 0
            z.sigTouch := 0
            z.srr := false
            z.dead := false
            zoneBreakUp := true
            brokeResistanceNow := true
        else if inZone and close <= z.top and not z.dead
            if justEntered
                z.touches := z.touches + 1
                if z.state == 0 and z.touches >= 2
                    z.state := 1
                if (z.state != 2 and z.touches > maxTouches) or (z.state == 2 and z.touches > 2)
                    z.dead := true
            tradable = not z.dead and ((z.state == 1 and z.touches >= 2) or (z.srr and z.touches >= 1) or (z.state == 2 and z.touches >= 1 and z.touches <= 2))
            okTrend  = not useTrendFilter or trendDown or z.state == 2
            fresh    = z.sigTouch != z.touches
            if tradable and okTrend and fresh and bearConfirm and close < z.top
                z.sigTouch := z.touches
                if z.state == 2 and z.touches == 2
                    po2Sell := true
                else
                    sellSig := true
    refreshZone(z)

// pass 2: SRR / RSS qualification (book: a Support whose move broke ≥2
// Resistances becomes an SRR buy zone; a Resistance whose move broke ≥2
// Supports becomes an RSS sell zone).
if brokeResistanceNow or brokeSupportNow
    for z in zones
        if z.state == 2 or z.dead
            continue
        if brokeResistanceNow and z.role == 1 and z.touches == 0 and close > z.top
            z.oppBreaks := z.oppBreaks + 1
            if z.oppBreaks >= 2
                z.srr := true
        if brokeSupportNow and z.role == -1 and z.touches == 0 and close < z.bot
            z.oppBreaks := z.oppBreaks + 1
            if z.oppBreaks >= 2
                z.srr := true
        refreshZone(z)

// ───────────────────── Liquidity Sweep (optional) ───────────────────────────
sweepHigh = showSweeps and not na(lastHigh) and high > lastHigh and close < lastHigh and math.max(open, close) < lastHigh
sweepLow  = showSweeps and not na(lastLow)  and low  < lastLow  and close > lastLow  and math.min(open, close) > lastLow
plotshape(sweepHigh, "Liquidity Sweep High", shape.xcross, location.abovebar, color.new(#f23645, 30), size = size.tiny)
plotshape(sweepLow,  "Liquidity Sweep Low",  shape.xcross, location.belowbar, color.new(#089981, 30), size = size.tiny)

// ───────────────────────────── Signals ─────────────────────────────────────
plotshape(buySig,  "BUY",      shape.triangleup,   location.belowbar, color.new(#089981, 0), size = size.small)
plotshape(sellSig, "SELL",     shape.triangledown, location.abovebar, color.new(#f23645, 0), size = size.small)
plotshape(po2Buy,  "PO2 BUY",  shape.labelup,      location.belowbar, color.new(#089981, 0), size = size.small, text = "PO2", textcolor = color.white)
plotshape(po2Sell, "PO2 SELL", shape.labeldown,    location.abovebar, color.new(#f23645, 0), size = size.small, text = "PO2", textcolor = color.white)

// ───────────────────────────── Alerts ──────────────────────────────────────
alertcondition(buySig or po2Buy,   "SNRZ Buy",        "SNRZ: BUY — V.S / SRR / I.VR / RBS zone rejection")
alertcondition(sellSig or po2Sell, "SNRZ Sell",       "SNRZ: SELL — V.R / RSS / I.VS / SBR zone rejection")
alertcondition(po2Buy,             "SNRZ PO2 Buy",    "SNRZ: Power of Second Touch — BUY")
alertcondition(po2Sell,            "SNRZ PO2 Sell",   "SNRZ: Power of Second Touch — SELL")
alertcondition(zoneBreakUp,        "SNRZ Break Up",   "SNRZ: Resistance broken (75%) → RBS/I.VR buy zone")
alertcondition(zoneBreakDn,        "SNRZ Break Down", "SNRZ: Support broken (75%) → SBR/I.VS sell zone")
