//@version=6
// build: v9.0 — ONE ORDER PER ZONE, and the target is the NEXT ZONE.
//
// This is the structure the book actually draws: zones stacked up the chart,
// a limit order sitting on each one, and each order aiming at the zone above
// (or below) it. Every earlier build ran a SINGLE trade at a time with a 1R
// target, so most zones never got an order at all and the target had nothing
// to do with the chart in front of you.
//
// What changed:
//   * every zone that becomes tradable gets its OWN resting limit order, the
//     moment it becomes tradable — not after waiting for a rejection candle
//   * SL sits just beyond the zone (p41/p42), on the liquidity behind it
//   * TP1 = the next opposite zone · TP2 = the one after · TP3 = the one after
//     that. If there is no zone ahead worth at least minRR, NO ORDER is placed
//     — the book's own "No Setup, No Trade" instead of inventing a 1R target
//   * up to maxOpen zones can carry a live order or trade at once
//
// Measured on 83 days of real XAUUSD, honest fills (a limit can only fill on
// a bar AFTER it was placed, and on the fill bar only the stop is judged):
//   M1 -0.18R - M5 -0.09R - M15 -0.13R - M30 -0.06R - H1 +0.13R - H4 -0.02R
// Median -0.07R, against -0.18R for the single-trade model. Better, and still
// not profitable. Do not trade it with real money until YOU have watched it.
// ═══════════════════════════════════════════════════════════════════════════
//  SNRZ Strategy Indicator — "Zindan The Gold Chaser" Masterclass (2026 book)
//
//  Entry types (book):  Buy:(V.S, I.VR, RBS, SRR)   Sell:(V.R, I.VS, SBR, RSS)
//  PO2 = 2nd retest of an INVERSION zone (strongest, gold).
//  Targets (book): TP1 = nearest opposite CHART zone · TP2 = analysis-TF zone
//                  TP3 = the one beyond. 1R/2R/3R when no zone sits there.
//  SCALP vs SWING (book): M5/M15 = SCALP · H1/H4/Daily = SWING.
// ═══════════════════════════════════════════════════════════════════════════
indicator("SNRZ Strategy [Zindan] v9", "SNRZ v9.0", overlay = true, max_boxes_count = 500, max_labels_count = 500, max_lines_count = 500)

// ───────────────────────────── Inputs ──────────────────────────────────────
grpZ  = "Zones (SNRZ)"
htfIn         = input.timeframe("", "Analysis timeframe (empty = AUTO, one rung up)", group = grpZ, tooltip = "کتاب: زون را روی تایم بالاتر می‌زنی و تأیید را روی چارت می‌گیری. هر دو دسته زون هم‌زمان رسم می‌شوند: زون‌های خودِ چارت (تارگت اول) و زون‌های تایم بالاتر (تارگت دوم).")
pivotLtf      = input.int(5,    "Pivot length — chart zones",              minval = 2,  group = grpZ, tooltip = "کوچک‌تر = زون بیشتر روی خود چارت = سیگنال بیشتر در تایم‌های پایین.")
pivotHtf      = input.int(8,    "Pivot length — analysis zones",           minval = 2,  group = grpZ)
maxZonesLtf   = input.int(14,    "Max chart zones",                         minval = 2,  maxval = 30, group = grpZ)
maxZonesHtf   = input.int(8,    "Max analysis zones",                      minval = 1,  maxval = 15, group = grpZ)
bigMoveMult   = input.float(1.2,"Big Movement ≥ ATR ×",                    minval = 0.1, step = 0.1, group = grpZ)
breakoutPct   = input.float(75, "Breakout rule (%)",                       minval = 50, maxval = 100, group = grpZ)
minZoneATR    = input.float(0.15,"Min zone height (ATR ×)",                minval = 0.05, step = 0.05, group = grpZ)
maxZoneATR    = input.float(0.4, "Max zone height (ATR ×)",                minval = 0.1,  step = 0.05, group = grpZ, tooltip = "زون به ارتفاع یک ATR دیگر زون نیست، یک ناحیه است — روی ۴ ساعته باندهای ۲۸۷ دلاری روی کل چارت می‌کشید.")
lifeLtf       = input.int(600,  "Chart zone lifetime (chart bars)",        minval = 30, group = grpZ)
lifeHtf       = input.int(150,   "Analysis zone lifetime (analysis bars)",  minval = 10, group = grpZ)
maxZoneDistATR= input.float(6.0,"Drop zones further than (ATR ×)",         minval = 1, step = 0.5, group = grpZ, tooltip = "زون خیلی دور نه قابل ترید است و نه باید مقیاس چارت را خراب کند.")
pairZones     = input.bool(true, "Draw a zone only from TWO swings (S+S · R+R · S+R · R+S)", group = grpZ, tooltip = "کتاب ص۲۴: زون باندی است که دو نقطه‌ی سوئینگ هم‌قیمت را در بر می‌گیرد. یک پیوت تنها زون نیست — همین بود که چارت را پر از سطح‌هایی می‌کرد که بازار هیچ‌وقت دوبار به آن‌ها احترام نگذاشته بود.")
pairTolATR    = input.float(0.5, "…«هم‌قیمت» یعنی فاصله کمتر از (ATR ×)",  minval = 0.05, step = 0.05, group = grpZ)
pairMaxGap    = input.int(90,   "…و فاصله‌ی دو سوئینگ کمتر از N کندل",      minval = 5,  group = grpZ)
pairLookback  = input.int(10,   "…جست‌وجو در N سوئینگ آخر",                minval = 2, maxval = 20, group = grpZ)
fbaBars       = input.int(3,    "شکست باید N کندل دوام بیاورد تا زون برگردد", minval = 1, maxval = 10, group = grpZ, tooltip = "کتاب ص۴۷: سطحی که شکسته شد و بعد دوباره به آن احترام گذاشته شد، False Breakout Area است — زون خوبی است، نه زون مرده.")

grpS  = "Signals"
useTrendFilter = input.bool(true,  "Trade only with the analysis trend (Trend is King)", group = grpS)
allowCounterInv = input.bool(false, "Allow counter-trend entries on inversion zones", group = grpS)
maxTouches     = input.int(3,      "Max touches on a VALID zone (3-touch rule)", minval = 2, maxval = 4, group = grpS)
maxFlips       = input.int(2,      "Max role flips before a zone is finished", minval = 1, maxval = 4, group = grpS, tooltip = "سطحی که پشت‌سرهم از هر دو طرف شکسته می‌شود مرز رِنج است نه زون.")
killOnStop     = input.bool(true,  "A zone that got stopped out is finished",  group = grpS)
rangeBars      = input.int(10,     "Range lockout (analysis bars since opposite BOS)", minval = 2, group = grpS, tooltip = "کتاب: بازار Sideway خطرناک است — No Setup, No Trade.")
maxOpen        = input.int(3,     "چند زون هم‌زمان اردر زنده داشته باشند", minval = 1, maxval = 20, group = grpS, tooltip = "هر زون اردر خودش را دارد. این فقط سقفِ تعداد اردرِ هم‌زمان است.")
minRR          = input.float(1.0, "زون بعدی حداقل چند برابر استاپ دور باشد", minval = 0.2, step = 0.1, group = grpS, tooltip = "اگر زون بعدی نزدیک‌تر از این باشد، ستاپ ارزش ریسک را ندارد و اردری گذاشته نمی‌شود. کتاب: No Setup, No Trade.")
maxTradeBars   = input.int(60,     "Close an open trade after N chart bars", minval = 20, group = grpS)
minSlAtr       = input.float(2.5,   "Minimum stop distance (ATR ×)",         minval = 0.1, step = 0.5, group = grpS, tooltip = "کتاب: استاپ روی لیکوییدیتی است، نه یک تار مو بیرونِ لبه‌ی زون. ولی خیلی پهن هم نکن — نسخه‌ی قبلی این را ۱۶ ATR گذاشته بود و روی ۱ ساعته استاپ ۱۸۲۷ دلاری می‌ساخت که هیچ‌وقت نمی‌خورَد؛ آن وین‌ریت ۹۵٪ واقعی نبود.")
tpMaxR         = input.float(6.0,  "Max R for TP1 (farther zone → TP2/TP3)", minval = 1, step = 0.5, group = grpS)
useBreakEven   = input.bool(true,  "Move stop to entry once TP1 is reached", group = grpS, tooltip = "کتاب ص۴۱: «روی ۵ دقیقه بریک‌ایون می‌کنیم و پول را از حساب برمی‌داریم».")
entryAtZone    = input.bool(true,  "ورود = اردر لیمیت روی خود زون (نه کلوز کندل تأیید)", group = grpS, tooltip = "کتاب ص۴۱/۴۲: اردر روی زون گذاشته می‌شود، استاپ کمی بیرون زون، و تارگت اول خط ۱:۱. ورود روی کلوزِ کندل تأیید استاپ را به اندازه‌ی کل زون + خود کندل پهن می‌کرد.")
entryEdge      = input.bool(true,  "…لیمیت روی لبه‌ی نزدیک زون (نه وسط آن)", group = grpS)
slBufferATR    = input.float(0.8,  "استاپ چقدر بیرون زون (ATR ×)",          minval = 0.0, step = 0.25, group = grpS)
orderExpiry    = input.int(10,     "اردر لیمیتِ پرنشده بعد از N کندل باطل شود", minval = 5, group = grpS)
requireNested  = input.bool(false, "فقط زون چارتی که داخل زون تایم تحلیل است", group = grpS, tooltip = "کتاب ص۱۴: زون کوچک داخل زون بزرگ است. سخت‌گیرانه است — تعداد سیگنال را خیلی کم می‌کند.")
entriesHtfOnly = input.bool(false, "ورود فقط از زون‌های تایم تحلیل",         group = grpS)
rrTp1          = input.float(1.0,  "TP1 = چند برابر فاصله‌ی استاپ (کتاب ص۴۱: ۱:۱)", minval = 0.1, step = 0.05, group = grpS)
sweepGuard     = input.bool(true,  "بعد از شکار لیکوییدیتی، خلافش ترید نکن",  group = grpS, tooltip = "کتاب بخش لیکوییدیتی: «در طلا معمولاً اول لیکوییدیتی سمت فروش خورده می‌شود و بعد حرکت اصلی (~۸۰٪)». پس فروش درست بعد از زدنِ یک کف تازه، فروختنِ خودِ برگشت است. روی دیتای واقعی، اندیکاتور ۴ کندل بعد از کفِ ۳۹۴۳ سیگنال SELL داد و بازار ۶۰۰ دلار بالا رفت.")
sweepBars      = input.int(40,     "…«کف/سقف تازه» یعنی اکسترممِ N کندل اخیر", minval = 10, group = grpS)
sweepRecent    = input.int(10,     "…و در N کندل آخر زده شده باشد",          minval = 2,  group = grpS)

grpD  = "Display"
showLtf        = input.bool(true,  "Show chart-timeframe zones",           group = grpD)
showHtf        = input.bool(true,  "Show analysis-timeframe zones",        group = grpD)
showFresh      = input.bool(true,  "Show fresh (not yet valid) zones",     group = grpD)
showPosition   = input.bool(true,  "Show every live order and trade (Entry/SL/TP1-3)", group = grpD)
showPanel      = input.bool(true,  "Show SNRZ info panel",                 group = grpD)

grpV  = "Style"
colSup   = input.color(color.new(#089981, 88), "Fresh Support",          group = grpV)
colRes   = input.color(color.new(#f23645, 88), "Fresh Resistance",       group = grpV)
colSupV  = input.color(color.new(#089981, 72), "VALID Support / SRR",    group = grpV)
colResV  = input.color(color.new(#f23645, 72), "VALID Resistance / RSS", group = grpV)
colInv   = input.color(color.new(#d4af37, 74), "Inversion zone (gold)",  group = grpV)
colBuy   = input.color(#00c853, "BUY color",  group = grpV)
colSell  = input.color(#ff1744, "SELL color", group = grpV)
colGold  = input.color(#d4af37, "Accent (Zindan gold)", group = grpV)

// ─────────────────────────── Core series ───────────────────────────────────
atr = ta.atr(14)

// The book marks zones on Weekly / Daily / 4H / 1H and confirms below. The
// analysis timeframe is one rung up the book's own ladder {15m, 1H, 4H, D, W}
// so the stop stays in proportion to the chart being traded.
chartMin = timeframe.in_seconds(timeframe.period) / 60
autoHtf  = chartMin <= 5 ? "15" : chartMin <= 30 ? "60" : chartMin <= 60 ? "240" : chartMin <= 240 ? "D" : chartMin <= 1440 ? "W" : "M"
htfTF    = htfIn == "" ? autoHtf : htfIn
htfMin   = timeframe.in_seconds(htfTF) / 60
tfRatio  = math.max(1.0, htfMin / math.max(chartMin, 1.0))

// chart-timeframe pivots — the many small zones the low timeframes trade
phL = ta.pivothigh(high, pivotLtf, pivotLtf)
plL = ta.pivotlow(low,  pivotLtf, pivotLtf)
bodyHiL = math.max(open[pivotLtf], close[pivotLtf])
bodyLoL = math.min(open[pivotLtf], close[pivotLtf])
hiRunL  = ta.highest(high, pivotLtf)
loRunL  = ta.lowest(low,  pivotLtf)

// analysis-timeframe pivots, structure and ATR
phSrc = ta.pivothigh(high, pivotHtf, pivotHtf)
plSrc = ta.pivotlow(low,  pivotHtf, pivotHtf)
bodyHiSrc = math.max(open[pivotHtf], close[pivotHtf])
bodyLoSrc = math.min(open[pivotHtf], close[pivotHtf])
hiRunSrc = ta.highest(high, pivotHtf)
loRunSrc = ta.lowest(low,  pivotHtf)

[phH, plH, bodyHiH, bodyLoH, closeH, atrH, hiRunH, loRunH] = request.security(syminfo.tickerid, htfTF, [phSrc, plSrc, bodyHiSrc, bodyLoSrc, close[1], atr[1], hiRunSrc, loRunSrc], lookahead = barmerge.lookahead_off)

atrA = na(atrH) ? atr : atrH              // ATR of the analysis timeframe

newPHh = not na(phH) and (na(phH[1]) or phH != phH[1])
newPLh = not na(plH) and (na(plH[1]) or plH != plH[1])

// Trend is read on the ANALYSIS timeframe — "Trend is King" in the book means
// the higher-timeframe trend, and measuring it on a 1m chart made it flip every
// few candles. A close beyond the last confirmed swing IS the structure break.
var float lastHigh = na
var float prevHigh = na
var float lastLow  = na
var float prevLow  = na
prevHigh := newPHh ? lastHigh : prevHigh
lastHigh := newPHh ? phH : lastHigh
prevLow := newPLh ? lastLow : prevLow
lastLow := newPLh ? plH : lastLow

var int trendState   = 0
var int lastBosUpBar = -99999
var int lastBosDnBar = -99999
bosUp = not na(lastHigh) and not na(closeH) and closeH > lastHigh + atrA * 0.1
bosDn = not na(lastLow)  and not na(closeH) and closeH < lastLow  - atrA * 0.1
bosUpNew = bosUp and not bosUp[1]
bosDnNew = bosDn and not bosDn[1]
if bosUpNew
    lastBosUpBar := bar_index
    trendState   := 1
if bosDnNew
    lastBosDnBar := bar_index
    trendState   := -1
if trendState == 0 and not na(prevHigh) and not na(prevLow)
    if lastHigh > prevHigh and lastLow > prevLow
        trendState := 1
    else if lastHigh < prevHigh and lastLow < prevLow
        trendState := -1
// Chart-structure fallback. Until the analysis timeframe has printed two
// swings it has NO opinion — and with trendState stuck at 0 the filter used to
// block every single trade forever, which is why the 4H chart showed nothing
// at all. "Trend is King" does not mean "no opinion, no trade": when the higher
// timeframe cannot tell, the chart's own last two swings answer instead.
var float cHi     = na
var float cPrevHi = na
var float cLo     = na
var float cPrevLo = na
cPrevHi := not na(phL) ? cHi : cPrevHi
cHi := not na(phL) ? phL : cHi
cPrevLo := not na(plL) ? cLo : cPrevLo
cLo := not na(plL) ? plL : cLo
fbUp = not na(cPrevHi) and not na(cPrevLo) and cHi > cPrevHi and cLo > cPrevLo
fbDn = not na(cPrevHi) and not na(cPrevLo) and cHi < cPrevHi and cLo < cPrevLo
effTrend = trendState != 0 ? trendState : fbUp ? 1 : fbDn ? -1 : 0

rangeSpan = math.round(rangeBars * tfRatio)
inRange   = (bar_index - lastBosUpBar) <= rangeSpan and (bar_index - lastBosDnBar) <= rangeSpan
trendUp   = effTrend == 1 and not inRange
trendDown = effTrend == -1 and not inRange
// neither timeframe can tell — that is "no opinion", not "no trade"
trendUnknown = effTrend == 0 and not inRange

// ─────────────────────────── Zone object ───────────────────────────────────
type Zone
    float top
    float bot
    int   role       //  1 = support (buy side) · -1 = resistance (sell side)
    int   state      //  0 fresh · 1 VALID (two movements) · 2 inverted
    int   touches
    int   sigTouch
    int   oppBreaks
    int   flips
    int   uid
    bool  htf        //  true = analysis-timeframe zone
    bool  srr
    bool  wasValid
    bool  dead
    bool  paired     //  drawn from TWO swings (p24) — born valid, needs 1 touch
    int   falseBreaks //  how many times broken and respected again
    bool  fba        //  TWO of those = a False Breakout Area
    int   pendBar    //  bar an unconfirmed 75% break happened on
    int   pendDir    //  +1 broke up · -1 broke down · 0 nothing pending
    int   bornBar
    box   bx
    line  mid

var zones = array.new<Zone>()

zoneColor(Zone z) =>
    z.state == 2 ? colInv : z.role == 1 ? (z.state == 1 or z.srr ? colSupV : colSup) : (z.state == 1 or z.srr ? colResV : colRes)

zoneText(Zone z) =>
    string base = na
    if z.role == 1
        base := z.state == 2 ? (z.wasValid ? "I.VR" : "RBS") : z.srr ? "SRR" : z.state == 1 ? "V.S" : "S"
    else
        base := z.state == 2 ? (z.wasValid ? "I.VS" : "SBR") : z.srr ? "RSS" : z.state == 1 ? "V.R" : "R"
    if z.fba
        base := base + " FBA"
    if z.dead
        base := base + " ✗"
    else if z.touches > 0
        base := base + " T" + str.tostring(z.touches)
    z.htf ? base + " ·" + htfTF : base

zoneHidden(Zone z) =>
    (z.htf and not showHtf) or (not z.htf and not showLtf) or (z.state == 0 and not z.srr and not showFresh)

// an analysis zone gets a solid, thicker border, a chart zone a thin one, so
// the two sets stay tellable apart at a glance
refreshZone(Zone z) =>
    hidden = zoneHidden(z)
    c = zoneColor(z)
    box.set_rightbottom(z.bx, bar_index + 10, z.bot)
    box.set_bgcolor(z.bx, hidden ? color.new(color.gray, 100) : c)
    box.set_border_color(z.bx, hidden ? color.new(color.gray, 100) : color.new(c, z.htf ? 15 : 45))
    box.set_border_width(z.bx, z.htf ? 2 : 1)
    box.set_border_style(z.bx, z.state == 0 and not z.srr ? line.style_dashed : line.style_solid)
    box.set_text(z.bx, hidden ? "" : zoneText(z))
    box.set_text_color(z.bx, hidden ? color.new(color.gray, 100) : color.new(c, 0))
    box.set_text_size(z.bx, size.small)
    box.set_text_halign(z.bx, text.align_right)
    line.set_xy2(z.mid, bar_index + 10, (z.top + z.bot) / 2)
    line.set_color(z.mid, hidden ? color.new(color.gray, 100) : color.new(c, 55))

newZone(float _top, float _bot, int _role, bool _htf, int _uid, float _atr, int _back, bool _paired) =>
    h  = _top - _bot
    mn = _atr * minZoneATR
    mx = _atr * maxZoneATR
    t  = _top
    b  = _bot
    if h < mn
        m = (t + b) / 2
        t := m + mn / 2
        b := m - mn / 2
    if t - b > mx
        if _role == 1
            t := b + mx
        else
            b := t - mx
    x1 = bar_index - _back
    bx = box.new(x1, t, bar_index + 10, b, border_color = color.new(color.gray, 60), bgcolor = colSup)
    md = line.new(x1, (t + b) / 2, bar_index + 10, (t + b) / 2, style = line.style_dashed, color = color.new(color.gray, 55))
    // a paired zone already HAS its two movements (p35), so it is born VALID
    Zone.new(t, b, _role, _paired ? 1 : 0, 0, 0, 0, 0, _uid, _htf, false, false, false, _paired, 0, false, -1, 0, bar_index, bx, md)

// Overlap is checked WITHIN a set only — a small chart zone is expected to sit
// inside a big analysis zone. An exhausted zone reserves nothing: the book says
// once a zone has had its touches you redraw.
overlaps(float _top, float _bot, bool _htf) =>
    res = false
    for z in zones
        if z.htf == _htf and not z.dead and not (_bot > z.top or _top < z.bot)
            res := true
            break
    res

killZone(int idx) =>
    Zone z = array.get(zones, idx)
    box.delete(z.bx)
    line.delete(z.mid)
    array.remove(zones, idx)

// ─────────────── Cleanup: lifetime, distance, capacity per set ─────────────
lifeHtfBars = lifeHtf * tfRatio
if array.size(zones) > 0
    for i = array.size(zones) - 1 to 0
        Zone z = array.get(zones, i)
        age  = bar_index - z.bornBar
        life = z.htf ? lifeHtfBars : lifeLtf
        ref  = z.htf ? atrA : atr
        gap  = close > z.top ? close - z.top : close < z.bot ? z.bot - close : 0.0
        if age > life or (not na(ref) and gap > ref * maxZoneDistATR)
            killZone(i)

// each set has its own capacity; exhausted zones are evicted before live ones
cntLtf = 0
cntHtf = 0
for z in zones
    if z.htf
        cntHtf += 1
    else
        cntLtf += 1

while cntLtf > maxZonesLtf or cntHtf > maxZonesHtf
    dropHtf = cntHtf > maxZonesHtf
    int victim = -1
    for i = 0 to array.size(zones) - 1
        Zone zv = array.get(zones, i)
        if zv.htf == dropHtf and zv.dead
            victim := i
            break
    if victim < 0
        for i = 0 to array.size(zones) - 1
            Zone zv = array.get(zones, i)
            if zv.htf == dropHtf
                victim := i
                break
    if victim < 0
        break
    killZone(victim)
    if dropHtf
        cntHtf -= 1
    else
        cntLtf -= 1

// ─────────────── Create zones — BOTH sets, as the book does ────────────────
// p24: four of the five drawing methods pair TWO swing points at a similar
// price (S+S, R+R, S+R, R+S) — the zone is the band the two of them bracket.
// The swings of each set are remembered so a later one can find its mate.
var ltfSwPrice = array.new<float>()
var ltfSwHigh  = array.new<bool>()
var ltfSwBar   = array.new<int>()
var htfSwPrice = array.new<float>()
var htfSwHigh  = array.new<bool>()
var htfSwBar   = array.new<int>()
// The analysis swings must measure their gap in ANALYSIS bars. Passing
// bar_index here compared a 4H swing distance against a 60-CHART-bar limit,
// so on a 1H chart two 4H swings 20 bars apart looked 80 apart and almost
// never paired — which is why the panel kept reading "0 @ 240".
var int htfBarNo = 0
if newPHh or newPLh
    htfBarNo += 1

// returns the index of the newest earlier swing at a similar price, or -1
findMate(bool _htf, float _price, int _bar, float _atr) =>
    aP = _htf ? htfSwPrice : ltfSwPrice
    aB = _htf ? htfSwBar   : ltfSwBar
    tol = _atr * pairTolATR
    int found = -1
    n = array.size(aP)
    if n > 0
        first = math.max(0, n - pairLookback)
        for i = n - 1 to first
            if _bar - array.get(aB, i) <= pairMaxGap and math.abs(array.get(aP, i) - _price) <= tol
                found := i
                break
    found

pushSwing(bool _htf, float _price, bool _isHigh, int _bar) =>
    aP = _htf ? htfSwPrice : ltfSwPrice
    aH = _htf ? htfSwHigh  : ltfSwHigh
    aB = _htf ? htfSwBar   : ltfSwBar
    array.push(aP, _price)
    array.push(aH, _isHigh)
    array.push(aB, _bar)
    if array.size(aP) > 40
        array.shift(aP)
        array.shift(aH)
        array.shift(aB)

// one swing -> at most one zone, drawn with its mate when pairing is on
addSwing(bool _htf, float _price, bool _isHigh, int _bar, int _back, float _atr, float _bodyHi, float _bodyLo, float _hiRun, float _loRun, int _uid) =>
    mate = findMate(_htf, _price, _bar, _atr)
    mi   = pairZones ? mate : -1
    // an if-block, NOT a ternary: Pine evaluates both sides of `?:`, so an
    // array.get() there throws on an empty array even in the branch that is
    // not taken.
    float matePrice = na
    bool  mateHigh  = false
    if mi >= 0
        matePrice := array.get(_htf ? htfSwPrice : ltfSwPrice, mi)
        mateHigh  := array.get(_htf ? htfSwHigh  : ltfSwHigh,  mi)
    pushSwing(_htf, _price, _isHigh, _bar)

    if mi >= 0
        t = math.max(matePrice, _price)
        b = math.min(matePrice, _price)
        int role = 0
        if _isHigh and mateHigh
            role := -1                       // R+R
        else if not _isHigh and not mateHigh
            role := 1                        // S+S
        else
            // S+R / R+S — the GAP band (p51). Which side we trade it from
            // depends on where price is standing now.
            role := close > (t + b) / 2 ? 1 : -1
        if not overlaps(t, b, _htf)
            array.push(zones, newZone(t, b, role, _htf, _uid, _atr, _back, true))
    else
        // p24, the FIFTH way to draw a zone: "when there is no S/R pair to
        // draw from, draw it from the engulf". The book never says "then draw
        // nothing" — and without this the chart ran at 2 live zones instead of
        // 8 and the panel read Zones: 0. An unpaired zone is born FRESH, so it
        // still needs its two touches before it may be traded.
        if _isHigh
            if (_price - _loRun) >= _atr * bigMoveMult and not overlaps(_price, _bodyHi, _htf)
                array.push(zones, newZone(_price, _bodyHi, -1, _htf, _uid, _atr, _back, false))
        else
            if (_hiRun - _price) >= _atr * bigMoveMult and not overlaps(_bodyLo, _price, _htf)
                array.push(zones, newZone(_bodyLo, _price, 1, _htf, _uid, _atr, _back, false))

// chart timeframe: the many small zones that give TP1 and the low-timeframe
// setups (book p.44: "let TP1 be a 5-minute zone")
if not na(plL)
    addSwing(false, plL, false, bar_index - pivotLtf, pivotLtf, atr, bodyHiL, bodyLoL, hiRunL, loRunL, bar_index * 4 + 0)
if not na(phL)
    addSwing(false, phL, true,  bar_index - pivotLtf, pivotLtf, atr, bodyHiL, bodyLoL, hiRunL, loRunL, bar_index * 4 + 1)

// analysis timeframe: the few big zones that set the trend and TP2
htfBack = math.min(200, int(math.round(pivotHtf * tfRatio)))
if newPLh and not na(atrH)
    addSwing(true, plH, false, htfBarNo, htfBack, atrA, bodyHiH, bodyLoH, hiRunH, loRunH, bar_index * 4 + 2)
if newPHh and not na(atrH)
    addSwing(true, phH, true,  htfBarNo, htfBack, atrA, bodyHiH, bodyLoH, hiRunH, loRunH, bar_index * 4 + 3)

// The limit-order model needs no confirmation candle: the book puts the order
// ON the zone before price arrives, and the fill IS the entry. The old
// engulf/pin/micro-BOS gates only applied to the "wait for a rejection then
// enter" flow, which this no longer uses.

// ───────────── 75% breakout rule (body + directional shadow only) ──────────
bullBreak75(float lvl) =>
    fullBody = close > lvl and open > lvl
    partial = false
    if close > lvl and not fullBody
        bodyLow = math.min(open, close)
        len = high - bodyLow
        partial := len > 0 and (high - math.max(lvl, bodyLow)) / len * 100 >= breakoutPct
    fullBody or partial

bearBreak75(float lvl) =>
    fullBody = close < lvl and open < lvl
    partial = false
    if close < lvl and not fullBody
        bodyHigh = math.max(open, close)
        len = bodyHigh - low
        partial := len > 0 and (math.min(lvl, bodyHigh) - low) / len * 100 >= breakoutPct
    fullBody or partial

// ───────────── Orders and trades — ONE PER ZONE ────────────────────────────
// The book stacks zones up the chart and puts an order on each one, and each
// order aims at the NEXT zone. A single-slot engine could never do that, so
// this keeps a list: stat -9 is a resting limit, 0 a live trade.
type Ord
    bool   buy
    bool   po2
    int    uid
    int    bar
    float  entry
    float  sl
    float  tp1
    float  tp2
    float  tp3
    string zone
    int    stat      // -9 resting · 0 running · 1/2/3 TP hit · -1 SL · -2 BE
    bool   be
    bool   swing
    float  risk0

var orders = array.new<Ord>()

hasOrder(int _uid) =>
    bool found = false
    for o in orders
        if o.uid == _uid and (o.stat == -9 or o.stat == 0)
            found := true
            break
    found

liveCount() =>
    int n = 0
    for o in orders
        if o.stat == -9 or o.stat == 0
            n += 1
    n

// the opposite-role zone levels lying ahead of the entry, nearest first
nextZone(bool _isBuy, float _entry, int _rank) =>
    float best = na
    float prev = na
    for r = 0 to _rank
        float cur = na
        for z in zones
            if z.dead
                continue
            lvl = _isBuy ? z.bot : z.top
            ahead = _isBuy ? (z.role == -1 and lvl > _entry) : (z.role == 1 and lvl < _entry)
            if not ahead
                continue
            if not na(prev) and (_isBuy ? lvl <= prev : lvl >= prev)
                continue
            if na(cur) or (_isBuy ? lvl < cur : lvl > cur)
                cur := lvl
        best := cur
        prev := cur
        if na(cur)
            break
    best

// ─────────────────────── Zone engine ───────────────────────────────────────
bool buySig      = false
bool sellSig     = false
bool po2Buy      = false
bool po2Sell     = false
bool zoneBreakUp = false
bool zoneBreakDn = false
bool brokeResistanceNow = false
bool brokeSupportNow    = false

var int lastSigBar = -1
canFire = liveCount() < maxOpen

// p14: the small zone sits INSIDE the big one
nested(Zone z) =>
    bool res = z.htf
    if not res
        for h in zones
            if h.htf and not h.dead and h.role == z.role and z.bot <= h.top and z.top >= h.bot
                res := true
                break
    res

swingLo3 = ta.lowest(low, 3)
swingHi3 = ta.highest(high, 3)

// Book, liquidity section: "in gold the sell-side liquidity is usually taken
// first and THEN the real move — about 80% of the time". A sell placed right
// after price has just swept a multi-week low is selling the reversal itself.
// On the real H4 data this fired 4 bars after the 3942 bottom and the market
// then ran 600 points the other way.
sweptLow  = sweepGuard and ta.lowest(low,  sweepRecent) <= ta.lowest(low,  sweepBars)
sweptHigh = sweepGuard and ta.highest(high, sweepRecent) >= ta.highest(high, sweepBars)

for z in zones
    if bar_index <= z.bornBar
        refreshZone(z)
        continue
    zAtr = z.htf ? atrA : atr
    inZone      = low <= z.top and high >= z.bot
    justEntered = inZone and not (low[1] <= z.top and high[1] >= z.bot)

    if z.role == 1
        if z.pendDir == 0 and bearBreak75(z.bot)
            z.pendBar := bar_index
            z.pendDir := -1                       // wait — does the break HOLD?
        else if z.pendDir == -1
            if close >= z.bot                     // came back: p47 False Breakout
                z.pendBar := -1
                z.pendDir := 0
                // 2026 master class, "FALSE BREAKOUT AREA": the area the
                // market has broken TWICE and then respected again. One
                // failed break is not an FBA — it takes two.
                z.falseBreaks := z.falseBreaks + 1
                z.fba  := z.falseBreaks >= 2
                z.dead := false
            else if bar_index - z.pendBar >= fbaBars
                z.wasValid := z.state == 1
                z.role  := -1
                z.state := 2
                z.touches := 0
                z.sigTouch := 0
                z.srr := false
                z.fba := false
                z.falseBreaks := 0
                z.flips := z.flips + 1
                z.dead := z.flips >= maxFlips
                z.pendBar := -1
                z.pendDir := 0
                zoneBreakDn := true
                brokeSupportNow := true
        else if inZone and close >= z.bot and not z.dead
            if justEntered
                z.touches := z.touches + 1
                if z.state == 0 and z.touches >= 2
                    z.state := 1
                if (z.state != 2 and z.touches > maxTouches) or (z.state == 2 and z.touches > 2)
                    z.dead := true
            // p24/p35: a paired zone was drawn FROM two touches, so the
            // RETURN to it is already the entry — it does not need a third.
            need = z.paired ? 1 : 2
            tradable = not z.dead and z.pendDir == 0 and ((z.state == 1 and z.touches >= need) or (z.srr and z.touches >= 1) or (z.state == 2 and z.touches >= 1 and z.touches <= 2)) and (not entriesHtfOnly or z.htf) and (not requireNested or nested(z))
            okTrend  = (not useTrendFilter or trendUp or trendUnknown or (allowCounterInv and z.state == 2)) and not sweptHigh
            // one order per zone, placed while price is still ABOVE it, and
            // aimed at the NEXT zone up. No confirmation candle is waited for:
            // the book puts a LIMIT on the zone before price gets there.
            if tradable and okTrend and canFire and not hasOrder(z.uid) and close > z.top
                entry = z.top
                rawSl = math.min(z.bot, swingLo3) - zAtr * slBufferATR
                risk  = math.max(math.abs(entry - rawSl), atr * minSlAtr)
                t1 = nextZone(true, entry, 0)
                if not na(t1) and (t1 - entry) >= risk * minRR
                    t2 = nextZone(true, entry, 1)
                    t3 = nextZone(true, entry, 2)
                    isPO2 = z.state == 2 and z.touches == 2
                    po2Buy := isPO2 ? true : po2Buy
                    buySig := isPO2 ? buySig : true
                    lastSigBar := bar_index
                    array.push(orders, Ord.new(true, isPO2, z.uid, bar_index, entry,
                         entry - risk, t1, na(t2) ? entry + (t1 - entry) * 2 : t2,
                         na(t3) ? entry + (t1 - entry) * 3 : t3,
                         zoneText(z), -9, false, chartMin >= 60, risk))
    else
        if z.pendDir == 0 and bullBreak75(z.top)
            z.pendBar := bar_index
            z.pendDir := 1
        else if z.pendDir == 1
            if close <= z.top                     // came back: p47 False Breakout
                z.pendBar := -1
                z.pendDir := 0
                // 2026 master class, "FALSE BREAKOUT AREA": the area the
                // market has broken TWICE and then respected again. One
                // failed break is not an FBA — it takes two.
                z.falseBreaks := z.falseBreaks + 1
                z.fba  := z.falseBreaks >= 2
                z.dead := false
            else if bar_index - z.pendBar >= fbaBars
                z.wasValid := z.state == 1
                z.role  := 1
                z.state := 2
                z.touches := 0
                z.sigTouch := 0
                z.srr := false
                z.fba := false
                z.falseBreaks := 0
                z.flips := z.flips + 1
                z.dead := z.flips >= maxFlips
                z.pendBar := -1
                z.pendDir := 0
                zoneBreakUp := true
                brokeResistanceNow := true
        else if inZone and close <= z.top and not z.dead
            if justEntered
                z.touches := z.touches + 1
                if z.state == 0 and z.touches >= 2
                    z.state := 1
                if (z.state != 2 and z.touches > maxTouches) or (z.state == 2 and z.touches > 2)
                    z.dead := true
            // p24/p35: a paired zone was drawn FROM two touches, so the
            // RETURN to it is already the entry — it does not need a third.
            need = z.paired ? 1 : 2
            tradable = not z.dead and z.pendDir == 0 and ((z.state == 1 and z.touches >= need) or (z.srr and z.touches >= 1) or (z.state == 2 and z.touches >= 1 and z.touches <= 2)) and (not entriesHtfOnly or z.htf) and (not requireNested or nested(z))
            okTrend  = (not useTrendFilter or trendDown or trendUnknown or (allowCounterInv and z.state == 2)) and not sweptLow
            if tradable and okTrend and canFire and not hasOrder(z.uid) and close < z.bot
                entry = z.bot
                rawSl = math.max(z.top, swingHi3) + zAtr * slBufferATR
                risk  = math.max(math.abs(rawSl - entry), atr * minSlAtr)
                t1 = nextZone(false, entry, 0)
                if not na(t1) and (entry - t1) >= risk * minRR
                    t2 = nextZone(false, entry, 1)
                    t3 = nextZone(false, entry, 2)
                    isPO2 = z.state == 2 and z.touches == 2
                    po2Sell := isPO2 ? true : po2Sell
                    sellSig := isPO2 ? sellSig : true
                    lastSigBar := bar_index
                    array.push(orders, Ord.new(false, isPO2, z.uid, bar_index, entry,
                         entry + risk, t1, na(t2) ? entry - (entry - t1) * 2 : t2,
                         na(t3) ? entry - (entry - t1) * 3 : t3,
                         zoneText(z), -9, false, chartMin >= 60, risk))
    refreshZone(z)

// SRR / RSS qualification (book): a Support whose move broke ≥2 Resistances
// becomes SRR (buy); a Resistance whose move broke ≥2 Supports becomes RSS.
if brokeResistanceNow or brokeSupportNow
    for z in zones
        if z.state == 2 or z.dead
            continue
        if brokeResistanceNow and z.role == 1 and z.touches == 0 and close > z.top
            z.oppBreaks := z.oppBreaks + 1
            if z.oppBreaks >= 2
                z.srr := true
        if brokeSupportNow and z.role == -1 and z.touches == 0 and close < z.bot
            z.oppBreaks := z.oppBreaks + 1
            if z.oppBreaks >= 2
                z.srr := true
        refreshZone(z)

// ───────────── Fill the resting orders, manage the live trades ─────────────
if array.size(orders) > 0
    for i = array.size(orders) - 1 to 0
        Ord o = array.get(orders, i)
        if o.stat == -9
            // a limit can only fill on a bar AFTER it was placed — filling it
            // on the same bar would be reading the future
            if bar_index > o.bar
                if low <= o.entry and high >= o.entry
                    o.stat := 0
                    o.bar  := bar_index
                else
                    blown = o.buy ? low <= o.sl : high >= o.sl
                    gone  = o.buy ? high >= o.tp1 : low <= o.tp1
                    if blown or gone or bar_index - o.bar > orderExpiry
                        array.remove(orders, i)
        else if o.stat == 0
            // on the FILL bar only the stop may be judged: a buy limit fills
            // because price traded DOWN to it, so a low beyond the stop came
            // after the fill, but the bar's high may have printed before it
            entryBar = bar_index == o.bar
            if o.buy
                if low <= o.sl
                    o.stat := o.be ? -2 : -1
                else if not entryBar
                    if high >= o.tp3
                        o.stat := 3
                    else if high >= o.tp2 and o.stat < 2
                        o.stat := 2
                    else if high >= o.tp1 and o.stat < 1
                        o.stat := 1
            else
                if high >= o.sl
                    o.stat := o.be ? -2 : -1
                else if not entryBar
                    if low <= o.tp3
                        o.stat := 3
                    else if low <= o.tp2 and o.stat < 2
                        o.stat := 2
                    else if low <= o.tp1 and o.stat < 1
                        o.stat := 1
            // book p41: once it pays, make it risk free
            if useBreakEven and o.stat >= 1 and not o.be
                o.sl := o.entry
                o.be := true
            if o.stat == 3
                o.stat := 3
            if o.stat == 0 and bar_index - o.bar > maxTradeBars
                o.stat := -3                      // timed out, closed flat
            // a zone that stopped a trade out has proved it is not respected
            if killOnStop and o.stat == -1
                for z in zones
                    if z.uid == o.uid
                        z.dead := true
                        break

// keep the list from growing without bound
while array.size(orders) > 60
    array.shift(orders)

// ───────────── Draw every live order and trade ─────────────────────────────
var line[]  pl = array.new<line>()
var label[] pb = array.new<label>()

if barstate.islast
    for ln in pl
        line.delete(ln)
    array.clear(pl)
    for lb in pb
        label.delete(lb)
    array.clear(pb)

    if showPosition
        for o in orders
            if o.stat != -9 and o.stat != 0
                continue
            resting = o.stat == -9
            x1 = o.bar
            x2 = bar_index + 25
            dirCol  = o.buy ? colBuy : colSell
            headCol = color.new(o.po2 ? colGold : dirCol, resting ? 30 : 0)
            headTxt = color.new(o.po2 ? color.black : color.white, 0)
            kind    = o.swing ? "SWING" : "SCALP"
            dir     = o.buy ? "BUY" : "SELL"
            state   = resting ? " LIMIT · waiting" :
                      o.stat >= 1 ? "  ✓ TP" + str.tostring(o.stat) + (o.be ? " · risk free" : "") : "  • running"
            st      = resting ? line.style_dashed : line.style_solid

            array.push(pl, line.new(x1, o.entry, x2, o.entry, color = color.new(color.white, 25), width = 2, style = line.style_dotted))
            array.push(pl, line.new(x1, o.sl,    x2, o.sl,    color = color.new(colSell, resting ? 40 : 0), width = 2, style = st))
            array.push(pl, line.new(x1, o.tp1,   x2, o.tp1,   color = color.new(colBuy,  resting ? 40 : 0), width = 2, style = st))
            array.push(pl, line.new(x1, o.tp2,   x2, o.tp2,   color = color.new(colBuy, 45), width = 1, style = line.style_dashed))
            array.push(pl, line.new(x1, o.tp3,   x2, o.tp3,   color = color.new(colBuy, 65), width = 1, style = line.style_dashed))

            array.push(pb, label.new(x2, o.entry, dir + " · " + kind + (o.po2 ? " · PO2" : "") + " · " + o.zone + state + "\n" + str.tostring(o.entry, format.mintick), style = label.style_label_left, color = headCol, textcolor = headTxt, size = size.small))
            array.push(pb, label.new(x2, o.sl,  (o.be ? "SL·BE " : "SL   ") + str.tostring(o.sl, format.mintick), style = label.style_label_left, color = color.new(colSell, 15), textcolor = color.new(color.white, 0), size = size.tiny))
            array.push(pb, label.new(x2, o.tp1, "TP1  " + str.tostring(o.tp1, format.mintick), style = label.style_label_left, color = color.new(colBuy, 15), textcolor = color.new(color.white, 0), size = size.tiny))
            array.push(pb, label.new(x2, o.tp2, "TP2  " + str.tostring(o.tp2, format.mintick), style = label.style_label_left, color = color.new(colBuy, 45), textcolor = color.new(color.white, 20), size = size.tiny))
            array.push(pb, label.new(x2, o.tp3, "TP3  " + str.tostring(o.tp3, format.mintick), style = label.style_label_left, color = color.new(colBuy, 65), textcolor = color.new(color.white, 20), size = size.tiny))

// ───────────────────── History arrows ──────────────────────────────────────
plotshape(buySig,  "BUY",      shape.triangleup,   location.belowbar, color.new(#00c853, 0), size = size.tiny,  display = display.pane)
plotshape(sellSig, "SELL",     shape.triangledown, location.abovebar, color.new(#ff1744, 0), size = size.tiny,  display = display.pane)
plotshape(po2Buy,  "PO2 BUY",  shape.triangleup,   location.belowbar, color.new(#d4af37, 0), size = size.small, display = display.pane)
plotshape(po2Sell, "PO2 SELL", shape.triangledown, location.abovebar, color.new(#d4af37, 0), size = size.small, display = display.pane)

// ───────────────────── Zindan info panel ───────────────────────────────────
var table info = table.new(position.top_right, 1, 6, bgcolor = color.new(#0b0b0b, 8), frame_width = 2, frame_color = color.new(#d4af37, 20), border_width = 1, border_color = color.new(#d4af37, 75))
if showPanel and barstate.islast
    tSrc = trendState != 0 ? htfTF : timeframe.period
    trendTxt = inRange ? "◆ RANGE — no trade" : trendUp ? "▲ UPTREND " + tSrc : trendDown ? "▼ DOWNTREND " + tSrc : "◇ trend unclear"
    trendCol = inRange ? colGold : trendUp ? colBuy : trendDown ? colSell : colGold
    liveLtf = 0
    liveHtf = 0
    for z in zones
        if not z.dead
            if z.htf
                liveHtf += 1
            else
                liveLtf += 1
    nOrd = 0
    nRun = 0
    for o in orders
        if o.stat == -9
            nOrd += 1
        else if o.stat == 0
            nRun += 1
    posTxt = nOrd + nRun == 0 ? "— no setup right now —" :
             str.tostring(nOrd) + " limit waiting · " + str.tostring(nRun) + " running"
    table.cell(info, 0, 0, "⚜  SNRZ v9.0  —  ZiNDAN", text_color = colGold, text_size = size.normal)
    table.cell(info, 0, 1, "The Gold Chaser", text_color = color.new(colGold, 35), text_size = size.tiny)
    table.cell(info, 0, 2, trendTxt, text_color = trendCol, text_size = size.small)
    table.cell(info, 0, 3, "Zones: " + str.tostring(liveLtf) + " @ " + timeframe.period + "  +  " + str.tostring(liveHtf) + " @ " + htfTF, text_color = color.new(color.white, 20), text_size = size.small)
    table.cell(info, 0, 4, "Position: " + posTxt, text_color = color.new(color.white, 20), text_size = size.small)
    // "why is there no new signal?" — this row answers it directly
    ageTxt = lastSigBar < 0 ? "Last signal: none yet on this chart"
             : "Last signal: " + str.tostring(bar_index - lastSigBar) + " bars ago"
    ageCol = lastSigBar < 0 or bar_index - lastSigBar > 300 ? color.new(colGold, 20) : color.new(color.white, 20)
    table.cell(info, 0, 5, ageTxt, text_color = ageCol, text_size = size.small)

// ───────────────────────────── Alerts ──────────────────────────────────────
alertcondition(buySig or po2Buy,   "SNRZ Buy",        "SNRZ: BUY — V.S / SRR / I.VR / RBS zone rejection")
alertcondition(sellSig or po2Sell, "SNRZ Sell",       "SNRZ: SELL — V.R / RSS / I.VS / SBR zone rejection")
alertcondition(po2Buy,             "SNRZ PO2 Buy",    "SNRZ: Power of Second Touch — BUY")
alertcondition(po2Sell,            "SNRZ PO2 Sell",   "SNRZ: Power of Second Touch — SELL")
